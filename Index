        async function cloudRequest(action, payload = {}, options = {}) {
            const session = await getAuthSession();
            if (action !== 'login' && !session) throw new Error('Sesi login tidak ditemukan. Silakan login kembali.');
            if (session) cloudSessionToken = session.access_token || '';

            if (action === 'ping') return { ok: true, app: 'ONPOINT APPAREL', version: 'SUPABASE' };

            if (action === 'login') {
                const role = String(payload.role || '').toLowerCase();
                const username = String(payload.username || '').trim().toLowerCase();
                if (!['owner','cs','produksi'].includes(role)) throw new Error('Role login tidak valid.');
                if (!username || !payload.password) throw new Error('Username dan password wajib diisi.');
                const { data, error } = await supabaseClient.functions.invoke('kms-auth', {
                    body: { action: 'login', role, username, password: payload.password }
                });
                if (error) throw sbError(error, 'Login gagal. Periksa username, role, dan password.');
                if (!data?.session?.access_token || !data?.session?.refresh_token) {
                    throw new Error(data?.error || 'Server login tidak mengembalikan sesi yang valid.');
                }
                const { error: sessionError } = await supabaseClient.auth.setSession({
                    access_token: data.session.access_token,
                    refresh_token: data.session.refresh_token
                });
                if (sessionError) throw sbError(sessionError, 'Sesi login tidak dapat diaktifkan.');
                try {
                    const profile = await getCurrentProfile(role);
                    return { ok: true, token: data.session.access_token, user: profile };
                } catch (err) {
                    await supabaseClient.auth.signOut();
                    throw err;
                }
            }

            if (action === 'bootstrap') {
                const profile = await getCurrentProfile(appData.role);
                const results = await Promise.all([
                    supabaseClient.from('orders').select('*').order('created_at', { ascending: false }),
                    supabaseClient.from('order_items').select('*'),
                    supabaseClient.from('payments').select('*'),
                    supabaseClient.from('customers').select('*').order('created_at', { ascending: false }),
                    supabaseClient.from('expenses').select('*').order('date', { ascending: false }),
                    supabaseClient.from('stock').select('*'),
                    supabaseClient.from('defects').select('*').order('created_at', { ascending: false })
                ]);
                const labels = ['orders','order_items','payments','customers','expenses','stock','defects'];
                results.forEach((r,i) => { if (r.error) throw sbError(r.error, `Gagal memuat ${labels[i]}.`); });
                const [orders, items, payments, customers, expenses, stock, defects] = results.map(r => r.data || []);

                // Periode keuangan harus disimpan bersama di Supabase, bukan hanya LocalStorage.
                const { data: financeSetting, error: financeSettingError } = await supabaseClient
                    .from('settings').select('value').eq('key', 'finance_periods_v1').maybeSingle();
                if (financeSettingError) throw sbError(financeSettingError, 'Gagal memuat periode keuangan bersama dari Supabase.');
                let financePeriods = [];
                if (financeSetting?.value) {
                    try {
                        const parsedPeriods = JSON.parse(financeSetting.value);
                        financePeriods = Array.isArray(parsedPeriods) ? parsedPeriods : [];
                    } catch (_) {
                        throw new Error('Data periode keuangan di Supabase tidak valid (format JSON).');
                    }
                }
                return { ok: true, data: {
                    financePeriods,
                    orders: orders.map(o => normalizeOrderFromSupabase(o, items, payments)),
                    payments,
                    customers,
                    expenses: expenses.map(x => ({ id:x.expense_id, date:x.date, category:x.category, desc:x.description, amount:Number(x.amount||0), createdBy:x.created_by||'', status:x.status||'Approved' })),
                    stock: stock.map(x => ({ id:x.stock_id, type:x.type, name:x.name, qty:Number(x.qty||0), unit:x.unit||'', minQty:Number(x.min_qty||0), supplier:x.supplier||'', note:x.note||'' })),
                    defects: defects.map(x => ({ id:x.defect_id, orderId:x.order_id||'', date:x.date||x.created_at||'', division:x.type||'', defectType:x.type||'', qty:Number(x.qty||0), action:x.description||'', status:x.status||'Open' }))
                }, config: {} };
            }

            if (action === 'updateDesignStatus') {
                const orderId = payload.orderId;
                const designStatus = String(payload.designStatus || '');
                const orderStatus = String(payload.orderStatus || '');
                if (!orderId) throw new Error('Order ID wajib diisi.');
                if (!designStatus) throw new Error('Status desain wajib diisi.');

                const patch = {
                    design_status: designStatus,
                    updated_at: new Date().toISOString()
                };
                if (orderStatus) patch.status = orderStatus;

                // Hanya ubah kolom yang memang terkait status desain.
                // Tidak menyentuh item, pembayaran, mockup, harga, atau data order lain.
                const { data, error } = await supabaseClient
                    .from('orders')
                    .update(patch)
                    .eq('order_id', orderId)
                    .select('order_id,design_status,status,updated_at')
                    .maybeSingle();

                if (error) throw sbError(error, 'Gagal menyimpan status desain ke Supabase.');
                if (!data) throw new Error('Order tidak ditemukan atau perubahan ditolak oleh database/RLS.');
                if (String(data.design_status || '') !== designStatus) {
                    throw new Error(`Verifikasi gagal: database mengembalikan status \"${data.design_status || ''}\".`);
                }
                if (orderStatus && String(data.status || '') !== orderStatus) {
                    throw new Error(`Verifikasi status order gagal: database mengembalikan \"${data.status || ''}\".`);
                }
                return { ok:true, data };
            }

            if (action === 'saveOrder') {
                const row = orderToRow(payload.order || {});
                if (!row.order_id) throw new Error('Order ID wajib diisi.');
                const { error } = await supabaseClient.from('orders').upsert(row, { onConflict:'order_id' });
                if (error) throw sbError(error, 'Gagal menyimpan order.');
                const orderId = row.order_id;
                const { error: delErr } = await supabaseClient.from('order_items').delete().eq('order_id', orderId);
                if (delErr) throw sbError(delErr, 'Gagal memperbarui item order.');
                const src = payload.order?.sizes || [];
                if (src.length) {
                    const rows = src.map((x,i) => {
                        const isBonus = x.bonus === true || x.bonus === 'true';
                        const qty = Number(x.qty || 0);
                        const price = isBonus ? 0 : Number(x.price || 0);
                        return {
                            item_id: `${orderId}-ITEM-${i+1}`,
                            order_id: orderId,
                            category: x.category || 'Dewasa',
                            size: x.size || '',
                            sleeve: x.sleeve || '',
                            qty,
                            price,
                            subtotal: qty * price,
                            bonus: isBonus
                        };
                    });
                    const { error: itemErr } = await supabaseClient.from('order_items').insert(rows);
                    if (itemErr) throw sbError(itemErr, 'Gagal menyimpan item order.');
                }
                return { ok:true };
            }

            if (action === 'deleteOrder') {
                const id = payload.orderId;
                const { error: itemErr } = await supabaseClient.from('order_items').delete().eq('order_id', id);
                if (itemErr) throw sbError(itemErr, 'Gagal menghapus item order.');
                const { error } = await supabaseClient.from('orders').delete().eq('order_id', id);
                if (error) throw sbError(error, 'Gagal menghapus order.');
                return { ok:true };
            }

            if (action === 'deletePayment') {
                const id = String(payload.id || '');
                if (!id) throw new Error('ID pembayaran wajib diisi.');

                // Ambil detail transaksi sebelum dihapus untuk koreksi DP awal.
                const { data: paymentRow, error: readError } = await supabaseClient
                    .from('payments')
                    .select('payment_id,order_id,payment_type,note')
                    .eq('payment_id', id)
                    .maybeSingle();
                if (readError) throw sbError(readError, 'Gagal memeriksa transaksi pembayaran.');
                if (!paymentRow) throw new Error('Transaksi tidak ditemukan di database atau akses ditolak.');

                const { data: deletedRows, error: deleteError } = await supabaseClient
                    .from('payments')
                    .delete()
                    .eq('payment_id', id)
                    .select('payment_id');
                if (deleteError) throw sbError(deleteError, 'Gagal menghapus pembayaran.');
                if (!deletedRows || !deletedRows.length) {
                    throw new Error('Pembayaran tidak terhapus. Periksa izin DELETE/RLS pada tabel payments.');
                }

                // DP awal juga dicatat pada kolom orders.dp. Sinkronkan nilainya
                // agar tidak tetap masuk hitungan setelah transaksi DP awal dihapus.
                if (String(paymentRow.payment_type || '').toLowerCase() === 'dp awal') {
                    const { error: orderError } = await supabaseClient
                        .from('orders')
                        .update({ dp: 0, updated_at: new Date().toISOString() })
                        .eq('order_id', paymentRow.order_id);
                    if (orderError) throw sbError(orderError, 'Pembayaran terhapus, tetapi kolom DP order gagal diperbarui.');
                }
                return { ok:true };
            }

            if (action === 'deleteExpense') {
                const id = payload.id;
                const { error } = await supabaseClient.from('expenses').delete().eq('expense_id', id);
                if (error) throw sbError(error, 'Gagal menghapus pengeluaran.');
                return { ok:true };
            }

            const simple = {
                savePayment: ['payments', 'payment', 'payment_id'],
                saveExpense: ['expenses', 'expense', 'expense_id'],
                saveStock: ['stock', 'stock', 'stock_id'],
                saveDefect: ['defects', 'defect', 'defect_id'],
                saveCustomer: ['customers', 'customer', 'customer_id']
            };
            if (simple[action]) {
                const [table, key, idField] = simple[action];
                const src = payload[key] || {};
                let row;
                if (action === 'savePayment') row = { payment_id:src.id||src.payment_id, order_id:src.orderId||src.order_id, date:src.date||new Date().toISOString().slice(0,10), amount:Number(src.amount||0), method:src.method||'', note:src.note||'', payer_name:src.payerName||src.payer_name||'', payment_type:src.paymentType||src.payment_type||'', created_by:src.createdBy||appData.currentUserName||'', created_at:src.created_at||new Date().toISOString() };
                if (action === 'saveExpense') row = { expense_id:src.id||src.expense_id, date:src.date||'', category:src.category||'Operasional', description:src.desc||src.description||'', amount:Number(src.amount||0), created_by:src.createdBy||appData.currentUserName||'', status:src.status||'Approved', created_at:src.created_at||new Date().toISOString(), updated_at:new Date().toISOString() };
                if (action === 'saveStock') row = { stock_id:src.id||src.stock_id, type:src.type||'', name:src.name||'', qty:Number(src.qty||0), unit:src.unit||'', min_qty:Number(src.minQty??src.min_qty??0), supplier:src.supplier||'', note:src.note||'', updated_at:new Date().toISOString() };
                if (action === 'saveDefect') row = { defect_id:src.id||src.defect_id, order_id:src.orderId||src.order_id||'', date:src.date||new Date().toISOString().slice(0,10), type:src.type||src.defectType||'', qty:Number(src.qty||0), description:src.description||src.action||'', status:src.status||'Open', created_by:src.createdBy||appData.currentUserName||'', created_at:src.created_at||new Date().toISOString() };
                if (action === 'saveCustomer') row = { customer_id:src.id||src.customer_id, name:src.name||'', phone:src.phone||'', address:src.address||'', notes:src.notes||'', created_at:src.created_at||new Date().toISOString(), updated_at:new Date().toISOString() };
                const { error } = await supabaseClient.from(table).upsert(row, { onConflict:idField });
                if (error) throw sbError(error, `Gagal menyimpan ${table}.`);
                return { ok:true };
            }

            if (action === 'getNotifications') {
                const { data, error } = await supabaseClient.from('notifications').select('*').eq('recipient_role', appData.role).order('created_at', { ascending:false }).limit(Number(payload.limit||50));
                if (error) throw sbError(error, 'Gagal mengambil notifikasi.');
                return { ok:true, data:data||[] };
            }
            if (action === 'markNotificationsRead') {
                const ids = payload.ids || [];
                if (ids.length) { const { error } = await supabaseClient.from('notifications').update({ read_at:new Date().toISOString() }).in('notification_id', ids); if (error) throw sbError(error,'Gagal menandai notifikasi.'); }
                return { ok:true };
            }
            if (action === 'saveFinancePeriods') {
                const periods = Array.isArray(payload.periods) ? payload.periods : [];
                const serialized = JSON.stringify(periods);
                const { error } = await supabaseClient.from('settings').upsert({
                    key: 'finance_periods_v1',
                    value: serialized,
                    updated_at: new Date().toISOString()
                }, { onConflict: 'key' });
                if (error) throw sbError(error, 'Gagal menyimpan periode keuangan bersama.');
                return { ok:true };
            }
            if (action === 'saveSettings') {
                const settings = payload.settings || {};
                for (const [key,value] of Object.entries(settings)) {
                    const { error } = await supabaseClient.from('settings').upsert({ key, value:String(value??''), updated_at:new Date().toISOString() }, { onConflict:'key' });
                    if (error) throw sbError(error,'Gagal menyimpan pengaturan.');
                }
                return { ok:true };
            }
            if (action === 'setDriveFolder') {
                const { error } = await supabaseClient.from('settings').upsert({ key:'drive_folder_id', value:String(payload.folderId||''), updated_at:new Date().toISOString() }, { onConflict:'key' });
                if (error) throw sbError(error,'Gagal menyimpan konfigurasi folder.');
                return { ok:true };
            }
            if (action === 'generateApprovalLink') {
                const orderId = String(payload.orderId||'');
                const token = (crypto.randomUUID().replace(/-/g,'') + crypto.randomUUID().replace(/-/g,'')).slice(0,64);
                const { error } = await supabaseClient.from('orders').update({ approval_token:token, approval_status:'Pending', approval_created_at:new Date().toISOString() }).eq('order_id',orderId);
                if (error) throw sbError(error,'Gagal membuat token approval.');
                return { ok:true, orderId, token };
            }
            if (action === 'syncSnapshot') {
                const d = payload.data || {};
                for (const o of (d.orders||[])) await cloudRequest('saveOrder',{order:o});
                for (const c of (d.customers||[])) await cloudRequest('saveCustomer',{customer:c});
                for (const x of (d.expenses||[])) await cloudRequest('saveExpense',{expense:x});
                for (const x of (d.stock||[])) await cloudRequest('saveStock',{stock:x});
                for (const x of (d.defects||[])) await cloudRequest('saveDefect',{defect:x});
                return { ok:true };
            }
            if (action === 'updatePasswords') {
                throw new Error('Perubahan password akun Auth dilakukan melalui Supabase Auth. Untuk keamanan, Owner tidak dapat mengubah password akun lain dari browser.');
            }
            if (action === 'uploadFile') {
                const fileName = String(payload.fileName || 'mockup.png');
                const mimeType = String(payload.mimeType || 'image/png');
                const base64 = String(payload.base64 || '');
                const orderId = String(payload.orderId || 'ORDER');
                if (!base64) throw new Error('Data gambar kosong.');
                if (!mimeType.startsWith('image/')) throw new Error('File mockup harus berupa gambar.');
                const cleanName = fileName.replace(/[^a-zA-Z0-9._-]/g, '_');
                const path = `orders/${orderId}/${Date.now()}-${cleanName}`;
                const binary = atob(base64);
                const bytes = new Uint8Array(binary.length);
                for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
                const blob = new Blob([bytes], { type: mimeType });
                const { data, error } = await supabaseClient.storage
                    .from('design-mockups')
                    .upload(path, blob, {
                        contentType: mimeType,
                        upsert: false,
                        cacheControl: '3600'
                    });
                if (error) throw sbError(error, 'Gagal upload mockup ke Supabase Storage.');
                const { data: publicData } = supabaseClient.storage
                    .from('design-mockups')
                    .getPublicUrl(data.path);
                const publicUrl = publicData?.publicUrl || '';
                if (!publicUrl) throw new Error('URL mockup tidak berhasil dibuat.');
                return {
                    ok: true,
                    fileId: data.path,
                    path: data.path,
                    url: publicUrl,
                    downloadUrl: publicUrl,
                    thumbnailUrl: publicUrl
                };
            }
            throw new Error('Fitur backend belum dipetakan: ' + action);
        }

        function setCloudStatus(text, mode = 'neutral') {
            const status = document.getElementById('cloud-sync-status');
            const label = document.getElementById('cloud-sync-text');
            if (!status || !label) return;
            status.classList.remove('hidden');
            label.innerText = text;
            status.title = text;
            status.setAttribute('aria-label', text);
            const icon = status.querySelector('i');
            if (icon) {
                icon.className = mode === 'ok'
                    ? 'fa-solid fa-cloud text-emerald-400 mr-2'
                    : mode === 'error'
                        ? 'fa-solid fa-cloud-bolt text-rose-400 mr-2'
                        : 'fa-solid fa-cloud text-sky-400 mr-2';
            }
        }

        function showCloudConfigResult(message, type = 'info') {
            const el = document.getElementById('cloud-config-result');
            if (!el) return;
            el.className = 'text-[10px] p-2 rounded-lg border ' + (
                type === 'success' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                type === 'error' ? 'bg-rose-50 text-rose-700 border-rose-200' :
                'bg-slate-50 text-slate-600 border-slate-200'
            );
            el.innerText = message;
            el.classList.remove('hidden');
        }

        async function testCloudConnection() {
            const url = document.getElementById('gas-url-input')?.value.trim() || getCloudUrl();
            if (!url) {
                showCloudConfigResult('Masukkan Web App Deployment URL terlebih dahulu.', 'error');
                return;
            }
            const oldUrl = appData.gasUrl;
            appData.gasUrl = url;
            try {
                showCloudConfigResult('Menghubungkan ke Supabase...', 'info');
                const result = await cloudRequest('ping');
                setCloudStatus('Cloud Connected', 'ok');
                showCloudConfigResult(`Koneksi berhasil. ${result.app || 'ONPOINT APPAREL'} - ${result.version || 'API'}`, 'success');
                showToast('Koneksi Supabase berhasil.', 'success');
            } catch (err) {
                appData.gasUrl = oldUrl;
                setCloudStatus('Cloud Error', 'error');
                showCloudConfigResult('Koneksi gagal: ' + err.message, 'error');
                showToast('Koneksi cloud gagal: ' + err.message, 'error');
            }
        }

        async function loadCloudDataAfterLogin() {
            if (!isCloudConfigured() || !cloudSessionToken) return false;
            try {
                setCloudStatus('Memuat Database...', 'neutral');
                const result = await cloudRequest('bootstrap');
                const d = result.data || {};

                appData.orders = Array.isArray(d.orders) ? d.orders.map(o => ({
                    ...o,
                    sizes: Array.isArray(o.sizes) ? o.sizes.map(s => ({
                        category: s.category || 'Dewasa',
                        sleeve: normalizeSleeveValue(s.sleeve),
                        size: s.size || '',
                        qty: Number(s.qty || 0),
                        price: Number(s.price || 0),
                        bonus: s.bonus === true || s.bonus === 'true' || s.is_bonus === true || s.is_bonus === 'true'
                    })) : []
                })) : [];
                appData.expenses = Array.isArray(d.expenses) ? d.expenses.map(x => ({
                    id: x.id || x.expense_id,
                    date: x.date || '',
                    category: x.category || 'Operasional',
                    desc: x.desc || x.description || '',
                    amount: Number(x.amount || 0),
                    createdBy: x.createdBy || x.created_by || '',
                    status: x.status || 'Approved'
                })) : [];
                appData.stock = Array.isArray(d.stock) ? d.stock.map(x => ({
                    id: x.id || x.stock_id,
                    type: x.type || '', name: x.name || '', qty: Number(x.qty || 0),
                    unit: x.unit || '', minQty: Number(x.minQty || x.min_qty || 0),
                    supplier: x.supplier || '', note: x.note || ''
                })) : [];
                appData.defects = Array.isArray(d.defects) ? d.defects.map(x => ({
                    id: x.id || x.defect_id,
                    orderId: x.orderId || x.order_id || '',
                    date: x.date || x.created_at || '',
                    division: x.division || x.type || '',
                    defectType: x.defectType || x.type || '',
                    qty: Number(x.qty || 0),
                    action: x.action || x.description || '',
                    status: x.status || 'Open'
                })) : [];
                appData.customers = Array.isArray(d.customers) ? d.customers : [];

                const localFinancePeriods = Array.isArray(appData.financePeriods) ? appData.financePeriods : [];
                const cloudFinancePeriods = Array.isArray(d.financePeriods) ? d.financePeriods : [];

                // Gabungkan data lokal dan cloud. Jangan pernah menghapus periode lokal
                // hanya karena cloud sudah memiliki periode lain. Ini penting untuk
                // memulihkan periode lama (misalnya November) yang belum sempat tersinkron.
                const mergedById = new Map();
                localFinancePeriods.forEach(period => {
                    if (!period || period.id == null) return;
                    mergedById.set(String(period.id), { ...period });
                });
                cloudFinancePeriods.forEach(period => {
                    if (!period || period.id == null) return;
                    const key = String(period.id);
                    mergedById.set(key, { ...(mergedById.get(key) || {}), ...period });
                });
                const mergedFinancePeriods = Array.from(mergedById.values())
                    .sort((a,b) => String(a.startDate || '').localeCompare(String(b.startDate || '')));
                appData.financePeriods = mergedFinancePeriods;

                // Jika hasil gabungan berbeda dari cloud, kirim gabungan tersebut
                // agar periode lama dari perangkat asal tersedia di semua perangkat.
                const cloudSnapshot = JSON.stringify(cloudFinancePeriods.slice().sort((a,b) => String(a?.startDate || '').localeCompare(String(b?.startDate || ''))));
                const mergedSnapshot = JSON.stringify(mergedFinancePeriods);
                if (mergedSnapshot !== cloudSnapshot && mergedFinancePeriods.length) {
                    await cloudRequest('saveFinancePeriods', { periods: mergedFinancePeriods });
                }

                // Pertahankan pilihan periode yang sedang dipilih jika masih tersedia.
                // Jika belum, pilih periode aktif terbaru; jika tidak ada, tampilkan semua riwayat.
                const selectedStillExists = appData.financePeriods.some(p => String(p.id) === String(appData.selectedFinancePeriodId));
                if (!selectedStillExists) {
                    const activePeriod = appData.financePeriods
                        .filter(p => !p.endDate)
                        .sort((a,b) => String(b.startDate || '').localeCompare(String(a.startDate || '')))[0];
                    appData.selectedFinancePeriodId = activePeriod?.id || 'all';
                }

                if (result.config?.driveFolderId) appData.driveFolder = result.config.driveFolderId;
                saveLocalState();
                setCloudStatus('Cloud Connected', 'ok');
                return true;
            } catch (err) {
                setCloudStatus('Cloud Error', 'error');
                showToast('Database cloud gagal dimuat: ' + err.message, 'error');
                return false;
            }
        }

