                        const statusClass = status === 'Selesai / Lunas' ? 'status-complete' : (['Potong Kain','Sablon / Bordir','Proses Jahit','QC & Packing'].includes(status) ? 'status-production' : (status === 'Desain Pending' ? 'status-pending' : 'status-queue'));
