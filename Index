            });

            const totalQty = sizes.reduce((s, i) => s + i.qty, 0);
            const totalPrice = sizes.reduce((s, i) => s + (i.qty * i.price), 0);

            const costFabric = Number(document.getElementById('cost-fabric-pcs')?.value || 28000);
            const costPrint = Number(document.getElementById('cost-print-pcs')?.value || 8000);
            const costSew = Number(document.getElementById('cost-sew-pcs')?.value || 7000);
            const costPack = Number(document.getElementById('cost-pack-pcs')?.value || 2000);
            const totalHpp = totalQty * (costFabric + costPrint + costSew + costPack);

            const existingId = document.getElementById('ord-id').value;
            
            // Get mockup data
            const imgEl = document.getElementById('temp-mockup-data');
            const localMockup = imgEl ? imgEl.src : '';
            const cloudUrl = document.getElementById('ord-mockup-url')?.value || '';

            const isNew = !existingId;
            const oldOrder = !isNew
                ? appData.orders.find(o => String(o.id) === String(existingId))
                : null;
            if (!isNew && !oldOrder) {
                showToast('Order yang akan diedit tidak ditemukan. Muat ulang daftar pesanan lalu coba lagi.', 'error');
                return;
            }
            const newId = isNew ? ('ORD-' + Math.floor(10000 + Math.random() * 90000)) : existingId;

            // Default status for new order by CS is Desain Pending
            let orderStatus = isNew ? 'Desain Pending' : 'Antrian'; 
            let designStatus = isNew ? 'Belum desain' : 'Approved';

            // if editing, preserve old status
            if(!isNew) {
                const old = appData.orders.find(o => o.id === existingId);
                if(old) {
                    orderStatus = old.status;
                    designStatus = old.designStatus || 'Approved';
                }
            }

            const orderObj = {
                id: newId,
                customer: document.getElementById('ord-customer').value.toUpperCase(),
                phone: document.getElementById('ord-wa').value,
                sablon: document.getElementById('ord-sablon').value,
                kain: document.getElementById('ord-kain').value,
                deadline: document.getElementById('ord-deadline').value,
                dp: Number(document.getElementById('ord-dp').value || 0),
                notes: document.getElementById('ord-notes').value,
                status: orderStatus,
                designStatus: designStatus,
                designVersion: isNew ? 'V1' : (appData.orders.find(o=>o.id===existingId)?.designVersion || 'V1'),
                designMockupLocal: localMockup || (appData.orders.find(o=>o.id===existingId)?.designMockupLocal || ''),
                designMockupCloud: cloudUrl || (appData.orders.find(o=>o.id===existingId)?.designMockupCloud || ''),
                sizes: sizes,
                hppFabric: costFabric, hppPrint: costPrint, hppSew: costSew, hppPack: costPack,
                // Semua angka ringkasan dihitung dari sizes yang sama dengan item order.
                totalQty: totalQty, paidQty: paidQty, bonusQty: bonusQty, totalPrice: totalPrice, totalHpp: totalHpp,
                createdAt: isNew ? new Date().toISOString().split('T')[0] : appData.orders.find(o=>o.id===existingId).createdAt
            };

            if (!isNew) {
                const idx = appData.orders.findIndex(o => o.id === existingId);
                if (idx >= 0) appData.orders[idx] = orderObj;
            } else {
                appData.orders.unshift(orderObj);
            }

            // Simpan lokal lebih dahulu agar form tidak menunggu server.
            saveLocalState();
            saveOrderToCloud(orderObj);
            saveCustomerToCloud({
                id: 'CUS-' + String(orderObj.phone || orderObj.customer).replace(/\D/g, '').slice(-12),
                name: orderObj.customer,
                phone: orderObj.phone,
                notes: ''
            });
            
            // Generate Invoice silently or print directly
            openPrintModal('invoice', orderObj.id);
            
            showToast(`Order ${orderObj.id} berhasil disimpan!`, 'success');
            setTimeout(() => switchTab('daftar-pesanan'), 500); // switch tab after a delay to show print modal
        }

