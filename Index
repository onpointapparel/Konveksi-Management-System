        function renderCRM() {
            const listContainer = document.getElementById('crm-list-container');
            const search = (document.getElementById('search-crm')?.value || '').toLowerCase();
            if (!listContainer) return;

            // Aggregate customer data
            const crmMap = {};
            appData.orders.forEach(o => {
                const key = o.phone; // use phone as unique identifier
                if (!crmMap[key]) {
                    crmMap[key] = { name: o.customer, phone: o.phone, orderCount: 0, ltv: 0, unpaid: 0, lastOrder: o.createdAt, orders: [] };
                }
                crmMap[key].orderCount += 1;
                crmMap[key].ltv += o.totalPrice;
                crmMap[key].unpaid += (o.totalPrice - getOrderTotalPaid(o));
                crmMap[key].orders.push(o);
                if(o.createdAt > crmMap[key].lastOrder) crmMap[key].lastOrder = o.createdAt;
            });

            let customers = Object.values(crmMap);
            
            // Apply Filters
            const filterType = window.currentCrmFilter || 'all';
            const thirtyDaysAgo = new Date(); thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
            
            if(filterType === 'new') {
                customers = customers.filter(c => c.orderCount === 1 && new Date(c.lastOrder) > thirtyDaysAgo);
            } else if (filterType === 'active') {
                customers = customers.filter(c => c.orderCount > 1);
            }

            if(search) {
                customers = customers.filter(c => c.name.toLowerCase().includes(search) || c.phone.includes(search));
            }

            document.getElementById('crm-total-count').innerText = `Total: ${customers.length}`;
            listContainer.innerHTML = '';

            if(customers.length === 0) {
                listContainer.innerHTML = `<div class="p-4 text-center text-xs text-slate-400">Tidak ada data customer.</div>`;
                return;
            }

            customers.forEach(c => {
                const isSelected = selectedCrmCustomer && selectedCrmCustomer.phone === c.phone;
                listContainer.innerHTML += `
                    <div onclick="selectCustomer('${c.phone}')" class="p-4 border-b border-slate-100 cursor-pointer hover:bg-slate-50 transition ${isSelected ? 'bg-brand-50 border-l-4 border-l-brand-600' : 'border-l-4 border-l-transparent'}">
