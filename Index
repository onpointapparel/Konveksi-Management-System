            const closingText = prompt('Masukkan saldo kas dan rekening aktual yang sudah dicocokkan (Rp):', '');
            if (closingText === null || closingText.trim() === '' || !Number.isFinite(Number(closingText)) || Number(closingText) < 0) { showToast('Saldo aktual belum valid; periode tidak ditutup.', 'error'); return; }

            const previousPeriods = JSON.parse(JSON.stringify(appData.financePeriods || []));
