                        <div class="flex flex-col items-end gap-1 shrink-0">
                            <div class="font-black text-[10px] text-emerald-600 whitespace-nowrap">${formatRp(p.amount)}</div>
                            ${canDeletePayment ? `<button type="button" onclick="deletePayment('${String(p.id || '').replace(/'/g, "\\'")}')" class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-rose-50 hover:bg-rose-100 text-rose-700 text-[9px] font-bold" title="Hapus transaksi pembayaran"><i class="fa-solid fa-trash"></i><span>Hapus</span></button>` : ''}
                        </div>
                    </div>
                </div>
            `).join('');
        }

        async function deletePayment(paymentId) {
            const orderId = document.getElementById('pay-order-id')?.value;
            const o = appData.orders.find(item => String(item.id) === String(orderId));
            if (!o) return showToast('Order tidak ditemukan.', 'error');
            const payment = (Array.isArray(o.payments) ? o.payments : []).find(p => String(p.id) === String(paymentId));
            if (!payment) return showToast('Transaksi pembayaran tidak ditemukan.', 'error');
            if (!['cs', 'owner'].includes(String(appData.role || '').toLowerCase())) {
                return showToast('Akses hapus pembayaran tidak diizinkan.', 'error');
            }

            const confirmed = window.confirm(
                `Hapus transaksi pembayaran ini?\\n\\n${payment.payerName || 'Customer'}\\n${formatPaymentDate(payment.date)}\\nNominal: ${formatRp(payment.amount)}\\n\\nTotal pembayaran dan sisa tagihan order akan dihitung ulang.`
            );
            if (!confirmed) return;

            try {
                // Batalkan job simpan yang belum diproses agar transaksi yang dihapus
                // tidak muncul kembali setelah antrean sinkronisasi berjalan.
                if (Array.isArray(fastSyncQueue)) {
                    fastSyncQueue = fastSyncQueue.filter(job =>
                        !(job.action === 'savePayment' && String(job.payload?.payment?.id) === String(paymentId))
                    );
                    persistFastSyncQueue();
                }

                // Hapus di Supabase terlebih dahulu. Jika gagal, data lokal tidak disentuh.
                if (isCloudConfigured()) {
                    if (!cloudSessionToken) throw new Error('Sesi cloud tidak tersedia. Silakan login kembali.');
                    await cloudRequest('deletePayment', { id: paymentId });
                }

                o.payments = (Array.isArray(o.payments) ? o.payments : [])
                    .filter(p => String(p.id) !== String(paymentId));

                // DP awal juga tersimpan pada kolom orders.dp untuk kompatibilitas data lama.
                // Nolkan kolom tersebut agar nominal DP yang dihapus tidak tetap terhitung.
                const isInitialDp = String(payment.paymentType || payment.payment_type || '').toLowerCase() === 'dp awal';
                if (isInitialDp) {
                    o.dp = 0;
                    if (isCloudConfigured()) await saveOrderToCloud(o);
                }

                saveLocalState();
                renderPaymentHistory(o);
                document.getElementById('pay-dp-val').innerText = formatRp(getOrderTotalPaid(o));
                document.getElementById('pay-sisa-val').innerText = formatRp(Math.max(0, Number(o.totalPrice || 0) - getOrderTotalPaid(o)));
                document.getElementById('pay-status-val').innerText = getPaymentStatus(o);
                showToast(`Pembayaran ${formatRp(payment.amount)} berhasil dihapus.`, 'success');
            } catch (err) {
                showToast('Gagal menghapus pembayaran: ' + err.message, 'error');
            }
        }

