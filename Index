            try {
                await saveFinancePeriodsToCloud();
            } catch (err) {
                appData.financePeriods = previousPeriods;
                saveLocalState(); refreshFinancePeriodOptions(); renderDashboard();
                showToast('Periode gagal diarsipkan ke cloud: ' + err.message, 'error');
                return;
            }

            if (confirm('Periode telah diarsipkan. Buat periode lanjutan dengan saldo akhir aktual sebagai saldo awal?')) {
                const next = new Date(`${closeDate}T12:00:00`); next.setDate(next.getDate()+1);
                const nextDate = `${next.getFullYear()}-${String(next.getMonth()+1).padStart(2,'0')}-${String(next.getDate()).padStart(2,'0')}`;
                const newPeriod = { id: 'FIN-' + Date.now(), name: `Periode setelah ${period.name}`, startDate: nextDate, endDate: '', openingBalance: period.actualClosingBalance, actualClosingBalance: null, createdAt: new Date().toISOString() };
                appData.financePeriods.push(newPeriod);
                appData.selectedFinancePeriodId = newPeriod.id;
                saveLocalState(); refreshFinancePeriodOptions(); renderDashboard();
                try {
                    await saveFinancePeriodsToCloud();
                    showToast('Periode lanjutan berhasil disimpan ke Supabase.', 'success');
                } catch (err) {
                    appData.financePeriods = appData.financePeriods.filter(p => String(p.id) !== String(newPeriod.id));
                    appData.selectedFinancePeriodId = period.id;
                    saveLocalState(); refreshFinancePeriodOptions(); renderDashboard();
                    showToast('Periode lanjutan gagal disimpan ke cloud: ' + err.message, 'error');
                }
            }
        }
