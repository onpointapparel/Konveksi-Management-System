        /* =========================================================
         * FAST CLOUD SYNC V2.1
         * UI tidak menunggu Google Sheets.
         * Setiap perubahan disimpan ke LocalStorage terlebih dahulu,
         * lalu dikirim ke Supabase secara berurutan di background.
         * =======================================================*/
        const FAST_SYNC_QUEUE_KEY = 'konveksi_dev_fast_sync_queue_v1';
        let fastSyncQueue = [];
        let fastSyncRunning = false;
        let fastRenderScheduled = false;

        function loadFastSyncQueue() {
            try {
                const raw = localStorage.getItem(FAST_SYNC_QUEUE_KEY);
                fastSyncQueue = raw ? JSON.parse(raw) : [];
                if (!Array.isArray(fastSyncQueue)) fastSyncQueue = [];
            } catch (e) {
                fastSyncQueue = [];
            }
        }

        function persistFastSyncQueue() {
            try {
                localStorage.setItem(FAST_SYNC_QUEUE_KEY, JSON.stringify(fastSyncQueue));
            } catch (e) {
                console.warn('Queue sinkronisasi tidak dapat disimpan:', e);
            }
        }

        function updateFastSyncStatus(text, mode = 'neutral') {
            const status = document.getElementById('cloud-sync-status');
            const label = document.getElementById('cloud-sync-text');
            if (!status || !label) return;
            status.classList.remove('hidden');
            label.innerText = text;
            status.title = text;
            status.setAttribute('aria-label', text);
            const icon = status.querySelector('i');
            if (icon) {
                icon.className = mode === 'ok'
                    ? 'fa-solid fa-cloud text-emerald-400 mr-2'
                    : mode === 'error'
                        ? 'fa-solid fa-cloud-bolt text-rose-400 mr-2'
                        : 'fa-solid fa-cloud-arrow-up text-sky-400 mr-2';
            }
        }

        function queueCloudSync(action, payload = {}, options = {}) {
            if (!isCloudConfigured() || !cloudSessionToken) return Promise.resolve(true);

            const job = {
                id: 'SYNC-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8),
                action,
                payload,
                attempts: 0,
                createdAt: new Date().toISOString()
            };

            fastSyncQueue.push(job);
            persistFastSyncQueue();
            updateFastSyncStatus(`Menyinkronkan... (${fastSyncQueue.length})`, 'neutral');

            // Mulai di event loop berikutnya agar klik/simpan selesai dulu.
            setTimeout(processFastSyncQueue, 0);

            // Penting: caller tidak perlu menunggu server.
            return Promise.resolve(true);
        }

        async function processFastSyncQueue() {
            if (fastSyncRunning || !fastSyncQueue.length) {
                if (!fastSyncQueue.length && isCloudConfigured()) {
                    updateFastSyncStatus('Cloud Synced', 'ok');
                }
                return;
            }

            if (!isCloudConfigured() || !cloudSessionToken) return;

            fastSyncRunning = true;
            const job = fastSyncQueue[0];

            try {
                job.attempts = Number(job.attempts || 0) + 1;
                await cloudRequest(job.action, job.payload);

                // Hanya hapus setelah server benar-benar menerima data.
                fastSyncQueue.shift();
                persistFastSyncQueue();

                if (fastSyncQueue.length) {
                    updateFastSyncStatus(`Menyinkronkan... (${fastSyncQueue.length})`, 'neutral');
                } else {
                    updateFastSyncStatus('Cloud Synced', 'ok');
                }
            } catch (err) {
                persistFastSyncQueue();
                updateFastSyncStatus('Menunggu sinkronisasi', 'error');

                // Jangan membuat browser macet dengan retry terus-menerus.
                // Retry dengan jeda bertahap sampai berhasil.
                const delay = Math.min(30000, 2000 * Math.pow(2, Math.min(job.attempts - 1, 4)));
                setTimeout(processFastSyncQueue, delay);
            } finally {
                fastSyncRunning = false;
            }

            if (fastSyncQueue.length && !fastSyncRunning) {
                setTimeout(processFastSyncQueue, 50);
            }
        }

