        async function getCurrentProfile(expectedRole) {
            const session = await getAuthSession();
            if (!session?.user?.id) throw new Error('Sesi Supabase tidak ditemukan. Silakan login kembali.');
            const { data, error } = await supabaseClient
                .from('users')
                .select('user_id,role,name,active,auth_user_id')
                .eq('auth_user_id', session.user.id)
                .maybeSingle();
            if (error) throw sbError(error, 'Gagal membaca profil pengguna dari public.users.');
