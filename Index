<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KONVEKSI Management System - Development</title>
    <!--
      FREE BONUS DATA CONTRACT:
      order_items.bonus (boolean) is the source of truth for Free Bonus Pembelian.
      Invoice, SPK, and order summary must derive their bonus/paid quantities from sizes.
    -->
    
    <!-- Tailwind CSS & FontAwesome & Chart.js -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Polishing pass: consistent spacing and predictable dashboard wrapping. */
        #view-dashboard { --dash-line: #e2e8f0; }
        #view-dashboard .dashboard-page-title { letter-spacing: -0.025em; line-height: 1.2; }
        #view-dashboard .dashboard-period-toolbar { border: 1px solid var(--dash-line); box-shadow: 0 4px 14px rgba(15, 23, 42, .04); }
        #view-dashboard #finance-period-select { min-height: 42px; max-width: 100%; }
        #view-dashboard .dashboard-toolbar-action { min-height: 40px; white-space: nowrap; transition: transform .15s ease, box-shadow .15s ease; }
        #view-dashboard .dashboard-toolbar-action:hover { transform: translateY(-1px); box-shadow: 0 4px 10px rgba(15, 23, 42, .10); }
        #view-dashboard #finance-period-banner { line-height: 1.65; border-radius: 14px; }
        #view-dashboard > .grid > div,
        #view-dashboard > div.grid > div { box-shadow: 0 4px 14px rgba(15, 23, 42, .035); }
        #view-dashboard #dash-financial-analysis p { line-height: 1.65; }
        #view-dashboard #dash-financial-analysis { overflow-wrap: anywhere; }
        @media (max-width: 767px) {
            #view-dashboard .dashboard-period-toolbar { align-items: stretch; }
            #view-dashboard .dashboard-period-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
            #view-dashboard .dashboard-period-actions button { justify-content: center; }
            #view-dashboard .dashboard-utility-actions { width: 100%; }
            #view-dashboard .dashboard-utility-actions button { flex: 1 1 auto; justify-content: center; }
        }
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-area, #printable-area * {
                visibility: visible;
            }
            #printable-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                padding: 20px;
                background: white;
                color: black;
            }
            .no-print {
                display: none !important;
            }
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        /* Colorful Operations redesign: left navigation, bright workspace, multicolor data accents. */
        #main-app { flex-direction: row; background: #f3f6fb; color: #17243b; }
        .app-sidebar { position: sticky; top: 0; display: flex; flex: 0 0 252px; flex-direction: column; width: 252px; height: 100vh; padding: 24px 16px 16px; color: #d9e4f4; background: linear-gradient(180deg,#101d38 0%,#14294a 100%); box-shadow: 8px 0 28px rgba(15,31,58,.10); z-index: 40; }
        .sidebar-brand { display:flex; align-items:center; gap:12px; padding: 2px 7px 24px; border-bottom:1px solid rgba(203,221,245,.14); }
        .sidebar-brand-icon { display:grid; place-items:center; width:42px; height:42px; border-radius:14px; color:#fff; font-size:20px; background:linear-gradient(135deg,#1687f8,#7258ef); box-shadow:0 7px 18px rgba(43,116,234,.3); }
        .sidebar-brand-name { display:block; color:#fff; font-size:18px; line-height:1.1; font-weight:800; letter-spacing:.04em; }
        .sidebar-brand-subtitle { display:block; margin-top:5px; color:#9eb3d2; font-size:9px; font-weight:700; letter-spacing:.16em; }
        .sidebar-version { color:#6f8cb6; letter-spacing:.05em; }
        .sidebar-section-label { padding:22px 10px 10px; color:#7187a9; font-size:9px; font-weight:800; letter-spacing:.16em; }
        .sidebar-navigation { flex:1; overflow-y:auto; overflow-x:hidden; }
        #nav-container { display:flex; flex-direction:column; gap:6px; }
        #nav-container .nav-btn-item { width:100%; min-height:44px; justify-content:flex-start; border:0; border-radius:12px; color:#b7c7df; text-align:left; background:transparent; }
        #nav-container .nav-btn-item i { display:inline-flex; width:22px; justify-content:center; font-size:15px; color:#72b8ff; }
        #nav-container .nav-btn-item:nth-child(4n + 2) i { color:#ffb84d; }
        #nav-container .nav-btn-item:nth-child(4n + 3) i { color:#37d4c1; }
        #nav-container .nav-btn-item:nth-child(4n + 4) i { color:#b292ff; }
        #nav-container .nav-btn-item:hover { color:#fff; background:rgba(255,255,255,.09); }
        #nav-container .nav-btn-item.is-active { color:#fff; background:linear-gradient(100deg,#147fe8,#7156e9); box-shadow:0 7px 18px rgba(36,103,220,.27); }
        #nav-container .nav-btn-item.is-active i { color:#fff; }
        .sidebar-footer { display:flex; align-items:center; gap:9px; margin-top:14px; padding:15px 10px 4px; border-top:1px solid rgba(203,221,245,.14); color:#8fa5c5; font-size:11px; }
        .sidebar-status-dot { width:8px; height:8px; border-radius:50%; background:#35d69b; box-shadow:0 0 0 4px rgba(53,214,155,.13); }
        .app-main-shell { display:flex; flex:1; flex-direction:column; min-width:0; min-height:100vh; }
        .app-topbar { border-bottom:1px solid #e6ebf3; box-shadow:0 3px 14px rgba(24,47,82,.04); }
        .app-topbar #cloud-sync-status, .app-topbar .bg-slate-800 { background:#f3f6fb; border-color:#e3e9f2; color:#596981; }
        .app-topbar #current-user-badge { color:#34445d; }
        .app-topbar #nav-notification-btn { color:#334155; }
        .app-content { max-width:none; }
        #main-app main > section { max-width:1600px; margin-left:auto; margin-right:auto; }
        #main-app .bg-white.rounded-2xl, #main-app .bg-white.rounded-xl { border-color:#e5eaf2; box-shadow:0 5px 18px rgba(24,47,82,.045); }
        #main-app .bg-brand-600 { background-color:#2478ed; }
        #main-app .text-brand-600, #main-app .text-brand-500 { color:#2478ed; }
        #main-app .border-brand-500 { border-color:#2478ed; }
        #main-app .bg-slate-100 { background-color:#f2f5fa; }
        #main-app .bg-gradient-to-r.from-brand-600 { background-image:linear-gradient(110deg,#237be9,#4b55d9 58%,#7754e8); }
        @media (max-width: 767px) {
            .app-sidebar { flex-basis:76px; width:76px; padding:16px 9px 12px; }
            .sidebar-brand { justify-content:center; padding:2px 0 18px; }
            .sidebar-brand > div:last-child, .sidebar-section-label, .sidebar-footer span:last-child, #nav-container .nav-btn-item span { display:none; }
            .sidebar-brand-icon { width:42px; height:42px; }
            #nav-container .nav-btn-item { justify-content:center; padding:12px 0; }
            #nav-container .nav-btn-item i { width:auto; font-size:17px; }
            .app-topbar > div { padding-left:12px; padding-right:12px; }
            .app-content { padding:14px 12px; }
        }
        @media (max-width: 520px) {
            .app-sidebar { flex-basis:64px; width:64px; padding-left:6px; padding-right:6px; }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- TOAST NOTIFICATION CONTAINER -->
    <div id="toastContainer" class="fixed top-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>
    <div id="cs-notification-panel" class="hidden fixed top-20 right-4 sm:right-6 z-50 w-[min(420px,calc(100vw-32px))] bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden">
        <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
            <div><div class="font-bold text-sm">Notifikasi CS</div><div class="text-[10px] text-slate-300">Approval desain customer</div></div>
            <button onclick="markAllCSNotificationsRead()" class="text-[10px] bg-white/10 hover:bg-white/20 px-2.5 py-1.5 rounded-lg">Tandai dibaca</button>
        </div>
        <div id="cs-notification-list" class="max-h-[420px] overflow-y-auto divide-y divide-slate-100">
            <div class="p-6 text-center text-xs text-slate-400">Belum ada notifikasi.</div>
        </div>
    </div>

    <div id="login-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900 bg-opacity-80 backdrop-blur-sm p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden border border-slate-100">
            <div class="bg-gradient-to-r from-slate-900 via-brand-900 to-slate-900 p-8 text-center text-white relative">
                <div class="w-20 h-20 bg-white/10 rounded-2xl mx-auto flex items-center justify-center mb-3 backdrop-blur-md border border-white/20 shadow-inner">
                    <i class="fa-solid fa-shirt text-4xl text-sky-400"></i>
                </div>
                <h1 class="text-2xl font-extrabold tracking-tight">ONPOINT APPAREL</h1>
                <p class="text-xs text-sky-300 tracking-wider uppercase mt-1">Management & Production System</p>
            </div>
            
            <form id="form-login" onsubmit="handleLogin(event)" class="p-6 sm:p-8 space-y-5">
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-500 mb-2">Pilih Akses Sistem</label>
                    <select id="login-role" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-sm font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none transition">
                        <option value="cs" selected>Customer Service (CS)</option>
                        <option value="produksi">Divisi Produksi</option>
                        <option value="owner">Owner Management</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-500 mb-2">Username</label>
                    <input type="text" id="login-username" required autocomplete="username" placeholder="Masukkan username..."
                           class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none transition">
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-500 mb-2">Password Sistem</label>
                    <div class="relative">
                        <input type="password" id="login-password" required placeholder="Masukkan password..." 
                               class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-4 pr-10 py-3 text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none transition">
                        <i class="fa-solid fa-lock absolute right-3 top-3.5 text-slate-400"></i>
                    </div>
                </div>

                <div id="login-error" class="hidden text-xs text-red-600 bg-red-50 p-3 rounded-lg border border-red-200 text-center font-medium">
                    Password salah! Silakan coba lagi.
                </div>

                <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-bold py-3.5 rounded-xl transition duration-200 shadow-lg shadow-brand-500/30 flex items-center justify-center space-x-2">
                    <span>Masuk ke Sistem</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>

                <div class="text-center text-xs text-slate-400 pt-2 border-t">
                    Password akun dikelola melalui Supabase Auth.
                </div>
            </form>
        </div>
    </div>

    <!-- MAIN APP STRUCTURE -->
    <div id="main-app" class="hidden flex flex-1 min-h-screen">
    <aside id="app-sidebar" class="app-sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon"><i class="fa-solid fa-shirt"></i></div>
            <div><span class="sidebar-brand-name">ONPOINT</span><span class="sidebar-brand-subtitle">APPAREL ERP <span class="sidebar-version">v4.6 DEV</span></span></div>
        </div>
        <div class="sidebar-section-label">MENU UTAMA</div>
        <nav class="sidebar-navigation custom-scrollbar" aria-label="Navigasi utama">
            <div id="nav-container"><!-- Dynamic sidebar navigation --></div>
        </nav>
        <div class="sidebar-toolbox" aria-label="Akses cepat">
            <div id="cloud-sync-status" class="sidebar-cloud-status" title="Mode Lokal" aria-label="Mode Lokal"><i class="fa-solid fa-cloud text-sky-400"></i><span id="cloud-sync-text" class="sr-only">Mode Lokal</span></div>
            <button onclick="openCloudSyncModal()" class="sidebar-tool-button sidebar-tool-config" title="Database Config" aria-label="Database Config"><i class="fa-solid fa-cloud-arrow-up"></i></button>
            <button id="nav-notification-btn" onclick="toggleCSNotificationPanel()" class="hidden sidebar-tool-button sidebar-tool-notification relative" title="Notifikasi" aria-label="Notifikasi"><i class="fa-regular fa-bell"></i><span id="global-notif-badge" class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-red-500 text-[9px] text-white">0</span></button>
            <button onclick="handleLogout()" class="sidebar-tool-button sidebar-tool-logout" title="Keluar" aria-label="Keluar"><i class="fa-solid fa-right-from-bracket"></i></button>
        </div>
        <button id="sidebar-owner-profile" type="button" class="sidebar-owner-profile hidden" onclick="openNewOrderFromWorkspace()" title="Buat Order Baru" aria-label="Buat Order Baru"><i class="fa-solid fa-cart-plus"></i><span>Buat Order</span></button>
        <span id="current-user-badge" class="sr-only">Customer Service</span>
        <div class="sidebar-footer"><span class="sidebar-status-dot"></span><span>Sistem operasional</span></div>
    </aside>
    <div class="app-main-shell">
<main class="app-content flex-1 min-w-0 w-full mx-auto p-4 sm:p-6 lg:p-8">
            
            <!-- 0. VIEW CS WORKSPACE (DASHBOARD AWAL CS) -->
            <section id="view-cs-workspace" class="space-y-6 hidden">
                <!-- Welcome Banner -->
                <div class="bg-gradient-to-r from-brand-600 to-slate-900 rounded-2xl p-6 text-white shadow-sm flex flex-col md:flex-row items-center justify-between gap-4">
                    <div>
                        <h2 class="text-2xl font-bold flex items-center gap-2">
                            Selamat datang, CS <span class="text-2xl">👋</span>
                        </h2>
                        <p id="cs-current-date" class="text-sky-200 mt-1 font-medium">Jumat, 4 September 2026</p>
                    </div>
                    <button onclick="openNewOrderFromWorkspace()" class="bg-white text-brand-700 hover:bg-sky-50 font-extrabold px-5 py-3 rounded-xl shadow-lg text-sm flex items-center gap-2 transition">
                        <i class="fa-solid fa-cart-plus"></i> Buat Order
                    </button>
                </div>

                <!-- CS Quick Stats -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 text-center hover:border-brand-300 transition">
                        <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Total Order Aktif</p>
                        <h3 id="cs-stat-order" class="text-3xl font-extrabold text-slate-800">8</h3>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 text-center hover:border-brand-300 transition relative">
                        <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Design Pending</p>
                        <h3 id="cs-stat-design" class="text-3xl font-extrabold text-brand-600">3</h3>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 text-center hover:border-brand-300 transition">
                        <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Perlu Follow Up</p>
                        <h3 id="cs-stat-followup" class="text-3xl font-extrabold text-amber-600">4</h3>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Notification / Action Needed Panel -->
                    <div class="lg:col-span-1 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="p-4 bg-slate-50 border-b border-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-bell text-red-500"></i>
                            <h3 class="font-bold text-slate-800 text-sm uppercase tracking-wide">Perlu Tindakan</h3>
                        </div>
                        <div class="p-4 space-y-3" id="cs-action-needed-list">
                            <!-- Dynamic Actions Injected by JS -->
                        </div>
                    </div>

                    <!-- Latest Orders Widget for CS -->
                    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="p-4 bg-slate-50 border-b border-slate-100 flex justify-between items-center">
                            <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2 uppercase tracking-wide">
                                <i class="fa-solid fa-clipboard-list text-brand-600"></i> Order Terbaru
                            </h3>
                            <button onclick="switchTab('daftar-pesanan')" class="text-xs text-brand-600 font-semibold hover:underline">Lihat Semua</button>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="text-slate-500 uppercase font-semibold border-b">
                                    <tr>
                                        <th class="p-3">ID & Status</th>
                                        <th class="p-3">Customer</th>
                                        <th class="p-3">Item & Tahap Produksi</th>
                                        <th class="p-3">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="cs-latest-orders-body" class="divide-y divide-slate-100">
                                    <!-- Injected by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 1. VIEW DASHBOARD (OWNER) -->
            <section id="view-dashboard" class="space-y-6 hidden">
                <div class="dashboard-heading-row">
                    <div class="min-w-0">
                        <h2 class="dashboard-page-title text-2xl md:text-3xl font-extrabold text-slate-900">Dashboard Owner</h2>
                        <p class="text-slate-500 text-sm mt-1">Ringkasan keuangan dan operasional konveksi.</p>
                    </div>
                    <div class="dashboard-utility-actions flex flex-wrap gap-2">
                        <button onclick="openNewOrderFromWorkspace()" class="dashboard-toolbar-action bg-brand-600 hover:bg-brand-700 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center space-x-2 shadow-sm" title="Buat Order Baru">
                            <i class="fa-solid fa-cart-plus"></i>
                            <span>Order Baru</span>
                        </button>
                        <button onclick="openPasswordSettings()" class="dashboard-toolbar-action owner-only hidden bg-slate-800 hover:bg-slate-900 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center space-x-2 shadow-sm" title="Pengaturan Password Login">
                            <i class="fa-solid fa-key"></i>
                            <span>Pengaturan</span>
                        </button>
                        <button onclick="openPrintModal('summary')" class="dashboard-toolbar-action bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-bold px-4 py-2.5 rounded-xl text-xs flex items-center space-x-2">
                            <i class="fa-solid fa-print"></i>
                            <span>Cetak Laporan</span>
                        </button>
                    </div>
                </div>
                <div class="dashboard-overview-grid grid grid-cols-1 lg:grid-cols-12 gap-4">
                    <div class="dashboard-kpi-grid dashboard-kpi-overview grid grid-cols-1 sm:grid-cols-2 gap-4 lg:col-span-6">
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-4">
                            <div class="w-12 h-12 bg-rose-100 text-rose-600 rounded-xl flex items-center justify-center text-xl"><i class="fa-solid fa-coins"></i></div>
                            <div><p class="text-xs font-medium text-slate-500 uppercase">Total Pendapatan</p><h3 id="dash-total-omset" class="text-xl font-bold text-slate-800">Rp 0</h3></div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-4">
                            <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center text-xl"><i class="fa-solid fa-users"></i></div>
                            <div><p class="text-xs font-medium text-slate-500 uppercase">Total Pelanggan</p><h3 id="dash-customer-count" class="text-xl font-bold text-slate-800">0</h3></div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-4">
                            <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center text-xl"><i class="fa-solid fa-shirt"></i></div>
                            <div><p class="text-xs font-medium text-slate-500 uppercase">Total Pesanan</p><h3 id="dash-total-orders" class="text-xl font-bold text-slate-800">0</h3></div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-4">
                            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center text-xl"><i class="fa-solid fa-industry"></i></div>
                            <div><p class="text-xs font-medium text-slate-500 uppercase">Total Produksi</p><h3 id="dash-production-qty" class="text-xl font-bold text-slate-800">0 pcs</h3></div>
                        </div>
                    </div>
                    <div class="dashboard-period-toolbar bg-white rounded-2xl p-4 lg:col-span-6">
                        <div class="min-w-0">
                            <label for="finance-period-select" class="block text-[10px] font-extrabold uppercase tracking-wider text-slate-500 mb-2">Periode keuangan</label>
                            <select id="finance-period-select" onchange="selectFinancePeriod(this.value)" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700">
                                <option value="all">Semua Riwayat</option>
                            </select>
                        </div>
