        async function fetchCSNotifications(initial = false) {
            if (csNotificationBusy || String(appData.role || '').toLowerCase() !== 'cs' || !cloudSessionToken || !isCloudConfigured()) return;
            csNotificationBusy = true;
            try {
                const result = await cloudRequest('getNotifications', { limit: 50 }, { timeout: 15000 });
                const incoming = Array.isArray(result.notifications) ? result.notifications : [];
                const previousIds = new Set(csNotifications.map(n => String(n.id)));
                const fresh = incoming.filter(n => !previousIds.has(String(n.id)));
                csNotifications = incoming;
                renderCSNotificationPanel();
                updateCSNotifications(Number(result.unread || 0));

                if (!initial && csNotificationInitialized && fresh.length) {
                    const newest = fresh[0];
                    const title = newest.type === 'DESIGN_APPROVED' ? 'Desain Disetujui' : 'Permintaan Revisi';
                    showToast(`${title}: ${newest.orderId} • ${newest.customer || 'Customer'}`, newest.type === 'DESIGN_APPROVED' ? 'success' : 'error');
                    try { if ('Notification' in window && Notification.permission === 'granted') new Notification('ONPOINT APPAREL - ' + title, { body: newest.message }); } catch (_) {}
                    await loadCloudDataAfterLogin();
                    renderAll();
                }
                csNotificationInitialized = true;
            } catch (err) {
                console.warn('CS notification polling:', err);
            } finally { csNotificationBusy = false; }
        }

