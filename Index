        async function downloadInvoicePDF() {
            try {
                const canvas = await getInvoiceExportCanvas();
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4', true);
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const margin = 8;
                const usableWidth = pageWidth - margin * 2;
                const usableHeight = pageHeight - margin * 2;
                const pxPerMm = canvas.width / usableWidth;
                const pageCanvasHeight = Math.max(1, Math.floor(usableHeight * pxPerMm));

                let sourceY = 0;
                let pageIndex = 0;
                while (sourceY < canvas.height) {
                    const sourceHeight = Math.min(pageCanvasHeight, canvas.height - sourceY);
                    const slice = document.createElement('canvas');
                    slice.width = canvas.width;
                    slice.height = sourceHeight;
                    const ctx = slice.getContext('2d');
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, slice.width, slice.height);
                    ctx.drawImage(canvas, 0, sourceY, canvas.width, sourceHeight, 0, 0, canvas.width, sourceHeight);

                    if (pageIndex > 0) pdf.addPage();
                    const renderedHeight = sourceHeight / pxPerMm;
                    pdf.addImage(slice.toDataURL('image/jpeg', 0.96), 'JPEG', margin, margin, usableWidth, renderedHeight, undefined, 'FAST');

                    sourceY += sourceHeight;
                    pageIndex++;
                }

                pdf.save(getInvoiceFilename('pdf'));
                showToast('Invoice PDF berhasil diunduh.', 'success');
            } catch (err) {
                console.error(err);
                showToast(err.message || 'Gagal membuat PDF invoice.', 'error');
            }
        }

