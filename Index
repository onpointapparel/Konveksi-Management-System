        async function syncJahitPayroll() {
            const p = getActivePayrollPeriod();
            if (!p || String(p.status).toUpperCase() !== 'OPEN') return showToast('Pilih periode yang masih terbuka.', 'error');

            const jahit = appData.employees.filter(e => e.active !== false && String(e.type).toLowerCase() === 'jahit');
            if (!jahit.length) return showToast('Tambahkan karyawan divisi Jahit terlebih dahulu.', 'error');

            let emp = jahit[0];
            if (jahit.length > 1) {
                const list = jahit.map((e, i) => `${i + 1}. ${e.name}`).join('\n');
                const answer = prompt('Pilih karyawan Jahit yang menerima borongan untuk periode ini:\n\n' + list, '1');
                if (answer === null) return;
                const idx = Number(answer) - 1;
                if (!jahit[idx]) return showToast('Pilihan karyawan tidak valid.', 'error');
                emp = jahit[idx];
            }

            // Pada workflow ONPOINT, selesai Jahit berarti order sudah melewati tahap "Proses Jahit".
            // Tahap berikutnya adalah QC & Packing, dan order Selesai/Lunas juga dianggap sudah selesai Jahit.
            const eligibleStatuses = new Set(['QC & Packing', 'Selesai / Lunas']);
            const start = new Date(`${p.start_date}T00:00:00`);
            const end = new Date(`${p.end_date}T23:59:59`);
            const orders = appData.orders.filter(o => {
                if (!eligibleStatuses.has(String(o.status || '').trim())) return false;
                // Database order belum memiliki kolom khusus "tanggal selesai jahit".
                // Untuk snapshot payroll, updatedAt dipakai sebagai tanggal perubahan status;
                // jika tidak tersedia, gunakan createdAt sebagai fallback.
                const rawDate = o.updatedAt || o.createdAt || o.created_at || '';
                const d = new Date(rawDate);
                return !Number.isNaN(d.getTime()) && d >= start && d <= end;
            });
            if (!orders.length) return showToast(`Belum ada order selesai Jahit pada periode ${p.period_name}. Status yang dibaca: QC & Packing / Selesai-Lunas.`, 'info');

            const qty = orders.reduce((sum, o) => {
                const fallback = (Array.isArray(o.sizes) ? o.sizes : []).reduce((n, item) => n + Number(item.qty || 0), 0);
                return sum + Number(o.totalQty || fallback || 0);
            }, 0);
            const bonusQty = orders.reduce((sum, o) => {
                const fromField = Number(o.bonusQty || 0);
                const fallback = (Array.isArray(o.sizes) ? o.sizes : []).reduce((n, item) => n + ((item.bonus === true || item.bonus === 'true') ? Number(item.qty || 0) : 0), 0);
                return sum + (fromField || fallback);
            }, 0);
            if (qty <= 0) return showToast('Order yang ditemukan belum memiliki jumlah pcs.', 'error');

            const rate = Number(emp.rate || 4000);
            const existing = getPayrollEmployeeItem(p.period_id, emp.id);
            const paid = existing ? getPayrollPaidFor(p.period_id, emp.id) : 0;
            const gross = qty * rate;
            const remaining = Math.max(0, gross - paid);
            const row = {
                payroll_item_id: existing?.payroll_item_id || ('PITEM-' + Date.now()),
                period_id: p.period_id,
                employee_id: emp.id,
                employee_name: emp.name,
                division: 'Jahit',
                qty,
                rate,
                gross_amount: gross,
                paid_amount: paid,
                remaining_amount: remaining,
                status: payrollStatus(gross, paid),
                notes: `Sinkron otomatis ${orders.length} order selesai Jahit: ${orders.map(o => o.id).join(', ')} • Total ${qty} pcs termasuk ${bonusQty} pcs Free Bonus Pembelian.`,
                created_at: existing?.created_at || new Date().toISOString(),
                updated_at: new Date().toISOString()
            };

            try {
                const { error } = await supabaseClient.from('payroll_items').upsert(row, { onConflict: 'period_id,employee_id' });
                if (error) throw sbError(error, 'Gagal menyimpan snapshot Jahit.');
                await loadPayrollData();
                showToast(`${orders.length} order selesai Jahit tersinkron • ${qty} pcs • ${formatRp(gross)}.`, 'success');
            } catch (err) {
                console.error('syncJahitPayroll:', err);
                showToast('Gagal sinkronisasi Jahit: ' + err.message, 'error');
            }
        }

