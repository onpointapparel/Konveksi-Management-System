        async function handleSavePayrollPayment(e) {
            e.preventDefault();
            const p = getActivePayrollPeriod();
            if (!p || String(p.status).toUpperCase() !== 'OPEN') return showToast('Periode tidak tersedia atau sudah ditutup.', 'error');
            const employeeId = document.getElementById('payroll-pay-employee').value;
            const item = getPayrollEmployeeItem(p.period_id, employeeId);
            if (!item) return showToast('Snapshot gaji belum tersedia.', 'error');
            const total = Number(item.gross_amount || 0);
            const paid = getPayrollPaidFor(p.period_id, employeeId);
            const amount = Number(document.getElementById('payroll-pay-amount').value);
            if (!Number.isFinite(amount) || amount <= 0 || amount > total - paid) return showToast('Nominal pembayaran tidak valid.', 'error');

            const row = {
                payment_id: 'PAYROLLPAY-' + Date.now(),
                payroll_item_id: item.payroll_item_id,
                payment_date: document.getElementById('payroll-pay-date').value,
                payer_name: document.getElementById('payroll-pay-recipient').value.trim(),
                amount,
                method: document.getElementById('payroll-pay-method').value,
                note: document.getElementById('payroll-pay-note').value.trim(),
                created_by: appData.currentUserName || 'OWNER',
                created_at: new Date().toISOString()
            };
            const { error } = await supabaseClient.from('payroll_payments').insert(row);
            if (error) return showToast('Gagal menyimpan pembayaran gaji: ' + error.message, 'error');

            const newPaid = paid + amount;
            await supabaseClient.from('payroll_items').update({
                paid_amount: newPaid,
                remaining_amount: Math.max(0, total - newPaid),
                status: payrollStatus(total, newPaid),
                updated_at: new Date().toISOString()
            }).eq('payroll_item_id', item.payroll_item_id);

            closeModal('modalPayrollPayment');
            await loadPayrollData();
            showToast('Pembayaran gaji berhasil dicatat.', 'success');
        }

