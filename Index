                }))
            };
        }

        function getOrderTotalPaid(o) {
            const tx = Array.isArray(o?.payments) ? o.payments : [];

            // Jika transaksi DP awal sudah ada, jumlahkan seluruh transaksi saja.
            // Jika belum ada transaksi DP awal, tambahkan field dp lama sebagai fallback.
            // Ini menjaga kompatibilitas data historis tanpa menggandakan DP yang sudah tercatat.
            if (tx.length > 0) {
                const transactionTotal = tx.reduce((sum, p) => {
                    const amount = Number(p?.amount || 0);
                    return sum + (Number.isFinite(amount) ? amount : 0);
                }, 0);
                const hasInitialDp = tx.some(p =>
                    String(p?.paymentType || p?.payment_type || '').toLowerCase().includes('dp')
                );
                return hasInitialDp ? transactionTotal : transactionTotal + Number(o?.dp || 0);
            }
            const legacyDp = Number(o?.dp || 0);
            return Number.isFinite(legacyDp) ? legacyDp : 0;
        }

        function formatPaymentDate(value) {
            if (!value) return '-';
            const raw = String(value).trim();
            const match = raw.match(/^(\\d{4})-(\\d{2})-(\\d{2})/);
            const date = match
                ? new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])))
                : new Date(raw);
            if (Number.isNaN(date.getTime())) return raw;
            return new Intl.DateTimeFormat('id-ID', {
                day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC'
            }).format(date);
        }

        function getPaymentStatus(o) {
            const total = Number(o?.totalPrice || 0);
            const paid = getOrderTotalPaid(o);
            if (paid <= 0) return 'BELUM BAYAR';
            if (paid >= total) return 'LUNAS';
            if (paid > 0) return 'CICILAN';
            return 'BELUM BAYAR';
        }

