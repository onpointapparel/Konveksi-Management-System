        function getOrderSizeSummaryFromRows() {
            let totalQty = 0, paidQty = 0, bonusQty = 0, totalPrice = 0;
            document.querySelectorAll('#sizes-container > div').forEach(row => {
                const qty = Math.max(0, Number(row.querySelector('.qty-val')?.value || 0));
                const price = Math.max(0, Number(row.querySelector('.price-val')?.value || 0));
                const bonus = !!row.querySelector('.bonus-val')?.checked;
                totalQty += qty;
                if (bonus) bonusQty += qty; else { paidQty += qty; totalPrice += qty * price; }
            });
            return { totalQty, paidQty, bonusQty, totalPrice };
        }

