        async function updateDesignStatus(id, newStatus) {
            const o = appData.orders.find(item => String(item.id) === String(id));
            if (!o) {
                showToast(`Order ${id} tidak ditemukan.`, 'error');
                return;
            }

            const allowedStatuses = ['Belum desain', 'Sedang dikerjakan', 'Menunggu approval', 'Revisi', 'Approved'];
            if (!allowedStatuses.includes(newStatus)) {
                showToast('Status desain tidak valid.', 'error');
                renderDesignCenter();
                return;
            }

            const oldDesignStatus = o.designStatus || 'Belum desain';
            const oldOrderStatus = o.status || '';
            let nextOrderStatus = oldOrderStatus;

            // Hanya status order pada tahap awal yang boleh digerakkan oleh status desain.
            // Status produksi yang sudah berjalan tidak disentuh.
            if (newStatus === 'Approved' && oldOrderStatus === 'Desain Pending') {
                nextOrderStatus = 'Antrian';
            } else if (newStatus !== 'Approved' && (oldOrderStatus === 'Desain Pending' || oldOrderStatus === 'Antrian')) {
                nextOrderStatus = 'Desain Pending';
            }

            if (!isCloudConfigured() || !cloudSessionToken) {
                showToast('Cloud belum terhubung atau sesi login tidak valid.', 'error');
                renderDesignCenter();
                return;
            }

            // Jangan biarkan snapshot saveOrder lama yang masih menunggu mengembalikan
            // status desain ke nilai sebelumnya setelah perubahan ini berhasil.
            if (Array.isArray(fastSyncQueue)) {
                fastSyncQueue = fastSyncQueue.filter(job => {
                    const jobOrderId = job?.payload?.order?.id || job?.payload?.order?.order_id;
                    return !(job?.action === 'saveOrder' && String(jobOrderId) === String(id));
                });
                persistFastSyncQueue();
            }

            try {
                // Operasi khusus ini langsung UPDATE kolom orders di Supabase dan
                // tidak melewati queue/saveOrder. Setelah UPDATE, cloudRequest juga
                // membaca kembali row untuk memastikan database benar-benar menerima nilai.
                const result = await cloudRequest('updateDesignStatus', {
                    orderId: o.id,
                    designStatus: newStatus,
                    orderStatus: nextOrderStatus
                });

                if (!result?.ok || !result?.data) {
                    throw new Error('Supabase tidak mengonfirmasi perubahan status desain.');
                }

                // Baru setelah database terverifikasi, ubah state lokal.
                o.designStatus = newStatus;
                if (nextOrderStatus) o.status = nextOrderStatus;
                saveLocalState();
                renderAll();

                if (newStatus === 'Approved' && oldOrderStatus === 'Desain Pending') {
                    showToast(`Desain ${id} Approved. Order masuk antrian produksi.`, 'success');
                } else if (oldDesignStatus !== newStatus) {
                    showToast(`Status Desain ${id} tersimpan sebagai ${newStatus}.`, 'success');
                }
            } catch (err) {
                // State lokal tidak diubah sebelum database sukses, sehingga tidak
                // diperlukan rollback data order yang berisiko menimpa nilai cloud.
                renderDesignCenter();
                showToast(`Gagal menyimpan status desain ${id}: ${err?.message || err}`, 'error');
                console.error('ONPOINT design status update error:', err);
            }
        }

