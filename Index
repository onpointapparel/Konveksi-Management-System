                    return `<div class="dashboard-stage-row"><div class="dashboard-stage-label"><span><i class="fa-solid ${group.icon} stage-${group.color}"></i>${group.label}</span><b>${count}</b></div><div class="dashboard-stage-track"><span class="stage-fill-${group.color}" style="width:${pct}%"></span></div></div>`;
