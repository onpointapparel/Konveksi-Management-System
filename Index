        function normalizeDriveFolderInput(value) {
            const raw = String(value || '').trim();
            if (!raw) return '';
            const patterns = [
                /drive\.google\.com\/drive\/folders\/([a-zA-Z0-9_-]+)/i,
                /drive\.google\.com\/open\?id=([a-zA-Z0-9_-]+)/i,
                /[?&]id=([a-zA-Z0-9_-]+)/i
            ];
            for (const re of patterns) {
                const m = raw.match(re);
                if (m && m[1]) return m[1];
            }
            return raw;
        }

        async function syncDriveFolderToBackend(folderValue) {
            const folderId = normalizeDriveFolderInput(folderValue);
            if (!folderId) throw new Error('Folder Cloud Storage belum diisi.');
            if (!isCloudConfigured()) throw new Error('Supabase belum dikonfigurasi.');
            if (!cloudSessionToken) throw new Error('Sesi Owner belum aktif. Silakan login sebagai Owner terlebih dahulu.');
            if (String(appData.role || '').toLowerCase() !== 'owner') throw new Error('Hanya Owner yang dapat mengatur Folder Cloud Storage.');

            const result = await cloudRequest('setDriveFolder', { folderId: folderId }, { timeout: 20000 });
            appData.driveFolder = result.folderId || folderId;
            saveLocalState();
            return result;
        }

        async function saveDatabaseConfig() {
            const url = document.getElementById('gas-url-input')?.value.trim() || '';
            const folderRaw = document.getElementById('drive-folder-input')?.value.trim() || '';

            if (!url) {
                appData.gasUrl = '';
                appData.driveFolder = '';
                saveLocalState();
                document.getElementById('cloud-sync-status')?.classList.add('hidden');
                showCloudConfigResult('URL kosong. Sistem tetap berjalan dalam Mode Lokal.', 'info');
                showToast('Konfigurasi cloud dikosongkan. Mode Lokal aktif.', 'info');
                closeModal('modalCloudSync');
                return;
            }

            if (!/^https:\/\/script\.google\.com\//i.test(url)) {
                showCloudConfigResult('URL tidak valid. Gunakan URL Web App Apps Script yang berakhiran /exec.', 'error');
                showToast('URL Apps Script tidak valid.', 'error');
                return;
            }

            const oldUrl = appData.gasUrl;
            const oldFolder = appData.driveFolder;
            appData.gasUrl = url;
            saveLocalState();

            try {
                showCloudConfigResult('Menguji koneksi Supabase...', 'info');
                const ping = await cloudRequest('ping', {}, { timeout: 20000 });
                setCloudStatus('Cloud Connected', 'ok');

                // Folder hanya dapat disimpan ke backend setelah Owner login dan memiliki token.
                if (folderRaw) {
                    if (String(appData.role || '').toLowerCase() !== 'owner' || !cloudSessionToken) {
                        appData.driveFolder = oldFolder || normalizeDriveFolderInput(folderRaw);
                        saveLocalState();
                        showCloudConfigResult(
                            'Koneksi berhasil. Untuk menyimpan Folder Drive, logout lalu login sebagai Owner dan simpan konfigurasi ini lagi.',
                            'info'
                        );
                        showToast('Koneksi berhasil. Login sebagai Owner untuk mengaktifkan Folder Drive.', 'info');
                        return;
                    }

                    showCloudConfigResult('Memverifikasi dan menyimpan Folder Cloud Storage...', 'info');
                    const drive = await syncDriveFolderToBackend(folderRaw);
                    const folderId = drive.folderId || normalizeDriveFolderInput(folderRaw);
                    document.getElementById('drive-folder-input').value = folderId;
                    setCloudStatus('Drive Connected', 'ok');
                    showCloudConfigResult(
                        'Berhasil. Folder: ' + (drive.folderName || folderId),
                        'success'
                    );
                    showToast('Cloud Storage berhasil dikonfigurasi.', 'success');
                } else {
                    showCloudConfigResult(
                        'Koneksi berhasil: ' + (ping.app || 'ONPOINT APPAREL') + '. Folder Drive belum diatur.',
                        'success'
                    );
                    showToast('Koneksi Apps Script berhasil.', 'success');
                }

                if (String(appData.role || '').toLowerCase() === 'owner' && cloudSessionToken && document.getElementById('cs-notification-email')) {
                    const email = document.getElementById('cs-notification-email').value.trim();
                    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                        throw new Error('Format email CS tidak valid.');
                    }
                    await cloudRequest('saveSettings', { settings: { cs_notification_email: email } }, { timeout: 15000 });
                    appData.csNotificationEmail = email;
                    saveLocalState();
                }

                closeModal('modalCloudSync');
            } catch (err) {
                appData.gasUrl = oldUrl;
                appData.driveFolder = oldFolder;
                saveLocalState();
                setCloudStatus('Cloud Error', 'error');
                showCloudConfigResult('Konfigurasi gagal: ' + (err.message || err), 'error');
                showToast('Konfigurasi gagal: ' + (err.message || err), 'error');
            }
        }

        async function savePasswords() {
            if (appData.role !== 'owner') {
                showToast('Akses hanya untuk Owner Management.', 'error');
                return;
            }

            const currentPassword = document.getElementById('pwd-owner-current')?.value || '';
            const newPassword = document.getElementById('pwd-owner-new')?.value || '';
            const confirmPassword = document.getElementById('pwd-owner-confirm')?.value || '';

            if (!currentPassword || !newPassword || !confirmPassword) {
                showToast('Lengkapi password saat ini dan password baru.', 'error');
                return;
            }
            if (newPassword.length < 8) {
                showToast('Password baru minimal 8 karakter.', 'error');
                return;
            }
            if (newPassword !== confirmPassword) {
                showToast('Ulangan password baru tidak cocok.', 'error');
                return;
            }
            if (newPassword === currentPassword) {
                showToast('Password baru harus berbeda dari password saat ini.', 'error');
                return;
            }

            const button = document.querySelector('#config-pwd-section button[onclick="savePasswords()"]');
            const originalLabel = button?.innerHTML || 'Simpan Password Baru';
            if (button) { button.disabled = true; button.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Menyimpan...'; }

            try {
                const { error: verifyError } = await supabaseClient.auth.signInWithPassword({
                    email: ROLE_AUTH_EMAIL.owner,
                    password: currentPassword
                });
                if (verifyError) throw sbError(verifyError, 'Password saat ini tidak cocok.');

                const { error: updateError } = await supabaseClient.auth.updateUser({ password: newPassword });
                if (updateError) throw sbError(updateError, 'Password baru gagal disimpan.');

                ['pwd-owner-current','pwd-owner-new','pwd-owner-confirm'].forEach(id => {
                    const input = document.getElementById(id);
                    if (input) input.value = '';
                });
                closeModal('modalCloudSync');
                await handleLogout();
                showToast('Password Owner berhasil diubah. Silakan masuk kembali dengan password baru.', 'success');
            } catch (err) {
                showToast('Gagal mengubah password: ' + (err?.message || err), 'error');
            } finally {
                if (button) { button.disabled = false; button.innerHTML = originalLabel; }
            }
        }
