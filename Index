<script>
/* =========================================================
 * V2.2.3 REAL GOOGLE DRIVE IMAGE UPLOAD
 * =======================================================*/
(function () {
    let pendingMockupFile = null;

    const originalPreviewMockupUpload = window.previewMockupUpload;
    window.previewMockupUpload = function (e) {
        const file = e && e.target && e.target.files ? e.target.files[0] : null;
        if (!file) return;
        if (!String(file.type || '').startsWith('image/')) {
            if (typeof showToast === 'function') showToast('File yang dipilih harus berupa gambar.', 'error');
            e.target.value = '';
            return;
        }
        // Batas frontend lebih kecil dari backend untuk menghindari payload Apps Script terlalu besar.
        if (file.size > 5 * 1024 * 1024) {
            if (typeof showToast === 'function') showToast('Ukuran gambar maksimal 5 MB.', 'error');
            e.target.value = '';
            return;
        }
        pendingMockupFile = file;
        const reader = new FileReader();
        reader.onload = function (evt) {
            const box = document.getElementById('mockup-preview-box');
            if (box) box.innerHTML = `<img src="${evt.target.result}" id="temp-mockup-data" class="max-h-32 mx-auto rounded-lg shadow-md border object-contain"><p class="text-[10px] text-emerald-600 font-bold mt-1">Siap di-upload ke Cloud Storage: ${file.name}</p><p class="text-[9px] text-slate-400">${(file.size / 1024 / 1024).toFixed(2)} MB</p>`;
        };
        reader.readAsDataURL(file);
    };

    window.resetPendingMockupUpload = function () { pendingMockupFile = null; };

    async function uploadMockupToCloud(file, orderId) {
        if (!file) return null;
        if (!isCloudConfigured()) throw new Error('Supabase Storage belum dikonfigurasi. Gambar belum dapat di-upload ke Supabase Storage.');
        if (!cloudSessionToken) throw new Error('Sesi cloud belum aktif. Silakan login ulang.');
        if (file.size > 5 * 1024 * 1024) throw new Error('Ukuran gambar maksimal 5 MB.');

        const base64 = await new Promise(function(resolve, reject) {
            const reader = new FileReader();
            reader.onerror = function() { reject(new Error('Gagal membaca file gambar.')); };
            reader.onload = function() {
                const result = String(reader.result || '');
                const comma = result.indexOf(',');
                resolve(comma >= 0 ? result.slice(comma + 1) : result);
            };
            reader.readAsDataURL(file);
        });

        if (typeof setCloudStatus === 'function') setCloudStatus('Uploading Mockup ke Supabase...', 'neutral');
        const result = await cloudRequest('uploadFile', {
            fileName: file.name || ('mockup-' + orderId + '.png'),
            mimeType: file.type || 'image/png',
            base64: base64,
            orderId: orderId,
            category: 'DESIGN_MOCKUPS'
        });
        if (!result || !result.fileId) throw new Error('Server tidak mengembalikan ID file Cloud Storage.');
        if (typeof setCloudStatus === 'function') setCloudStatus('Mockup tersimpan di Supabase Storage', 'ok');
        return result;
    }

    // Kompatibilitas dengan kode lama: nama fungsi lama tetap diarahkan ke Supabase Storage.
    async function uploadMockupToGoogleDrive(file, orderId) {
        return uploadMockupToCloud(file, orderId);
    }

    // Save order terintegrasi: file di-upload lebih dulu, lalu URL Drive disimpan ke order.
    window.handleSaveOrder = async function(e) {
        e.preventDefault();
        const form = document.getElementById('form-new-order');
        const submitBtn = form ? form.querySelector('button[type="submit"]') : null;
        const oldBtn = submitBtn ? submitBtn.innerHTML : '';
        const existingId = document.getElementById('ord-id').value;
        const isNew = !existingId;
        const orderId = isNew ? ('ORD-' + Math.floor(10000 + Math.random() * 90000)) : existingId;
        const oldOrder = !isNew ? appData.orders.find(function(o) { return o.id === existingId; }) : null;

        try {
            if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...'; }

            let upload = null;
            if (pendingMockupFile) {
                if (submitBtn) submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Uploading gambar ke Cloud Storage...';
                upload = await uploadMockupToCloud(pendingMockupFile, orderId);
            }

            const sizes = [];
            document.querySelectorAll('#sizes-container > div').forEach(function(row) {
                sizes.push({
                    category: row.querySelector('.size-category')?.value || 'Dewasa',
                    sleeve: normalizeSleeveValue(row.querySelector('.sleeve-val')?.value),
                    size: row.querySelector('.size-val').value,
                    qty: Number(row.querySelector('.qty-val').value || 0),
                    price: row.querySelector('.bonus-val')?.checked ? 0 : Number(row.querySelector('.price-val').value || 0),
                    bonus: !!row.querySelector('.bonus-val')?.checked
                });
            });
            const totalQty = sizes.reduce(function(sum, item) { return sum + item.qty; }, 0);
            const bonusQty = sizes.reduce(function(sum, item) { return sum + (item.bonus ? item.qty : 0); }, 0);
            const paidQty = totalQty - bonusQty;
            const totalPrice = sizes.reduce(function(sum, item) { return sum + (item.bonus ? 0 : (item.qty * item.price)); }, 0);
            const costFabric = Number(document.getElementById('cost-fabric-pcs')?.value || 28000);
            const costPrint = Number(document.getElementById('cost-print-pcs')?.value || 8000);
            const costSew = Number(document.getElementById('cost-sew-pcs')?.value || 7000);
            const costPack = Number(document.getElementById('cost-pack-pcs')?.value || 2000);
            const totalHpp = totalQty * (costFabric + costPrint + costSew + costPack);

            let orderStatus = isNew ? 'Desain Pending' : 'Antrian';
            let designStatus = isNew ? 'Belum desain' : 'Approved';
            if (oldOrder) {
                orderStatus = oldOrder.status;
                designStatus = oldOrder.designStatus || 'Approved';
            }

            const manualCloudUrl = document.getElementById('ord-mockup-url')?.value || '';
            const orderObj = {
                id: orderId,
                customer: document.getElementById('ord-customer').value.toUpperCase(),
                phone: document.getElementById('ord-wa').value,
                sablon: document.getElementById('ord-sablon').value,
                kain: document.getElementById('ord-kain').value,
                deadline: document.getElementById('ord-deadline').value,
                // DP order lama dipertahankan; input DP hanya berlaku untuk order baru.
                dp: isNew ? Math.max(0, Number(document.getElementById('ord-dp').value || 0)) : Number(oldOrder.dp || 0),
                notes: document.getElementById('ord-notes').value,
                status: orderStatus,
                designStatus: designStatus,
                designVersion: isNew ? 'V1' : (oldOrder?.designVersion || 'V1'),
                // Jangan simpan base64 besar di localStorage/Google Sheets. Simpan URL file cloud.
                designMockupLocal: upload ? (upload.thumbnailUrl || upload.url || '') : (oldOrder?.designMockupLocal || ''),
                designMockupCloud: upload ? (upload.url || upload.downloadUrl || '') : (manualCloudUrl || oldOrder?.designMockupCloud || ''),
                sizes: sizes,
                // Pertahankan riwayat pembayaran lama saat order diedit. DP awal akan
                // disinkronkan sebagai transaksi pembayaran tersendiri setelah order tersimpan.
                payments: Array.isArray(oldOrder?.payments) ? oldOrder.payments.slice() : [],
                hppFabric: costFabric, hppPrint: costPrint, hppSew: costSew, hppPack: costPack,
                totalQty: totalQty, paidQty: paidQty, bonusQty: bonusQty, totalPrice: totalPrice, totalHpp: totalHpp,
                createdAt: isNew ? new Date().toISOString().split('T')[0] : oldOrder?.createdAt
            };

            if (isNew) appData.orders.unshift(orderObj);
            else {
                const idx = appData.orders.findIndex(function(o) { return o.id === existingId; });
                if (idx >= 0) appData.orders[idx] = orderObj;
            }

            if (submitBtn) submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan order...';
            await saveOrderToCloud(orderObj);

            // Hanya order baru yang membuat transaksi DP awal.
            // Saat edit, transaksi pembayaran tidak dibuat atau diperbarui.
            const initialDp = isNew ? Number(orderObj.dp || 0) : 0;
            if (isNew && initialDp > 0) {
                const dpPayment = {
                    id: orderObj.id + '-DP-AWAL',
                    orderId: orderObj.id,
                    date: orderObj.createdAt || new Date().toISOString().split('T')[0],
                    amount: initialDp,
                    method: 'Transfer BCA',
                    note: 'DP awal dari Form Order',
                    payerName: orderObj.customer,
                    paymentType: 'DP Awal',
                    createdBy: appData.currentUserName || ''
                };
                await savePaymentToCloud(dpPayment);
                const existingPayments = Array.isArray(orderObj.payments) ? orderObj.payments.filter(p => p.id !== dpPayment.id) : [];
                orderObj.payments = existingPayments.concat([dpPayment]);
                const localIdx = appData.orders.findIndex(function(x) { return x.id === orderObj.id; });
                if (localIdx >= 0) appData.orders[localIdx].payments = orderObj.payments;
            }

            await saveCustomerToCloud({
                id: 'CUS-' + String(orderObj.phone || orderObj.customer).replace(/\D/g, '').slice(-12),
                name: orderObj.customer,
                phone: orderObj.phone,
                notes: ''
            });

            pendingMockupFile = null;
            const fileInput = document.getElementById('ord-mockup');
            if (fileInput) fileInput.value = '';
            saveLocalState();
            openPrintModal('invoice', orderObj.id);
            showToast(`Order ${orderObj.id} berhasil disimpan${upload ? ' dan gambar tersimpan di Supabase Storage' : ''}!`, 'success');
            setTimeout(function() { switchTab('daftar-pesanan'); }, 500);
        } catch (err) {
            if (typeof setCloudStatus === 'function') setCloudStatus('Upload/Save Gagal', 'error');
            showToast('Order belum tersimpan: ' + err.message, 'error');
            console.error('ONPOINT Drive/order save error:', err);
        } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = oldBtn; }
        }
    };

    // Bersihkan file pending ketika form di-reset.
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('form-new-order');
        if (form) form.addEventListener('reset', function() { pendingMockupFile = null; });
    });
})();
</script>

