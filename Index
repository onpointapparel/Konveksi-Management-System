        async function saveMockupRevision(event) {
            if (event) event.preventDefault();
            const id = window.mockupEditOrderId;
            const order = appData.orders.find(o => String(o.id) === String(id));
            const fileInput = document.getElementById('mockup-edit-file');
            const file = fileInput && fileInput.files ? fileInput.files[0] : null;
            if (!order) return showToast('Pesanan tidak ditemukan.', 'error');
            if (!file) return showToast('Pilih mockup baru terlebih dahulu.', 'error');
            if (!file.type || !file.type.startsWith('image/')) return showToast('File harus berupa gambar.', 'error');
            if (file.size > 5 * 1024 * 1024) return showToast('Ukuran mockup maksimal 5 MB.', 'error');

            const btn = document.getElementById('mockup-edit-save');
            const oldHtml = btn ? btn.innerHTML : '';
            let upload = null;
            try {
                if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Uploading...'; }

                // 1. Upload file terlebih dahulu ke Supabase Storage.
                upload = await uploadMockupToCloud(file, order.id);
                if (!upload || !upload.fileId || !(upload.url || upload.downloadUrl)) {
                    throw new Error('Upload selesai, tetapi URL/ID file dari Supabase tidak lengkap.');
                }

                const m = String(order.designVersion || 'V1').match(/(\d+)/);
                const nextVersion = 'V' + ((m ? Number(m[1]) : 1) + 1);
                const note = document.getElementById('mockup-edit-note')?.value.trim() || '';
                const nextNotes = note
                    ? (order.notes ? order.notes + '\n' : '') + `[${nextVersion} - Revisi Desain] ${note}`
                    : (order.notes || '');
                const mockupUrl = upload.thumbnailUrl || upload.url || upload.downloadUrl || '';
                const cloudUrl = upload.url || upload.downloadUrl;

                // 2. Simpan hanya kolom revisi mockup. Jangan memakai saveOrderToCloud()
                //    karena fungsi tersebut memakai antrean background dan menulis ulang order_items.
                if (btn) btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Menyimpan...';
                const session = await getAuthSession();
                if (!session) throw new Error('Sesi login tidak ditemukan. Silakan login kembali.');

                const patch = {
                    design_version: nextVersion,
                    design_mockup_local: mockupUrl,
                    design_mockup_cloud: cloudUrl,
                    design_status: 'Menunggu approval',
                    status: 'Desain Pending',
                    approval_status: 'Pending',
                    approval_note: '',
                    approved_at: null,
                    approved_by_customer: '',
                    notes: nextNotes,
                    updated_at: new Date().toISOString()
                };

                const { data, error } = await supabaseClient
                    .from('orders')
                    .update(patch)
                    .eq('order_id', order.id)
                    .select('order_id,design_version,design_mockup_local,design_mockup_cloud,design_status,status,approval_status,updated_at')
                    .maybeSingle();

                if (error) throw sbError(error, 'Supabase gagal menyimpan revisi mockup.');
                if (!data) throw new Error('Pesanan tidak ditemukan atau perubahan ditolak oleh database/RLS.');
                if (String(data.design_version) !== nextVersion ||
                    String(data.design_status) !== 'Menunggu approval' ||
                    String(data.status) !== 'Desain Pending' ||
                    String(data.design_mockup_cloud || '') !== String(cloudUrl)) {
                    throw new Error('Verifikasi gagal: data revisi yang dikembalikan Supabase tidak sesuai.');
                }

                // 3. Perbarui data lokal hanya setelah database mengonfirmasi penyimpanan.
                order.designVersion = data.design_version;
                order.designMockupLocal = data.design_mockup_local || mockupUrl;
                order.designMockupCloud = data.design_mockup_cloud || cloudUrl;
                order.designStatus = data.design_status;
