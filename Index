        function getDeadlineBadge(deadlineStr, orderStatus = '') {
            if (String(orderStatus || '').trim().toLowerCase().includes('selesai')) {
                return '<span class="bg-emerald-100 text-emerald-800 border border-emerald-300 text-[10px] px-2 py-0.5 rounded font-bold"><i class="fa-solid fa-circle-check"></i> Selesai</span>';
            }
            if (!deadlineStr) return '<span class="bg-slate-100 text-slate-600 text-[10px] px-2 py-0.5 rounded font-bold">-</span>';

            // Parse YYYY-MM-DD sebagai tanggal kalender lokal tanpa pergeseran UTC.
            const match = String(deadlineStr).match(/^(\\d{4})-(\\d{2})-(\\d{2})/);
            const target = match
                ? new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]))
                : new Date(deadlineStr);
            if (Number.isNaN(target.getTime())) {
                return '<span class="bg-slate-100 text-slate-600 text-[10px] px-2 py-0.5 rounded font-bold">Deadline tidak valid</span>';
            }
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            target.setHours(0, 0, 0, 0);
            const diffDays = Math.round((target.getTime() - today.getTime()) / 86400000);

            if (diffDays < 0) return `<span class="bg-rose-100 text-rose-700 border border-rose-300 text-[10px] px-2 py-0.5 rounded font-bold"><i class="fa-solid fa-triangle-exclamation"></i> Overdue ${Math.abs(diffDays)} hari</span>`;
            if (diffDays === 0) return '<span class="bg-rose-500 text-white text-[10px] px-2 py-0.5 rounded font-bold"><i class="fa-solid fa-fire"></i> Hari Ini!</span>';
            if (diffDays <= 2) return `<span class="bg-amber-500 text-white text-[10px] px-2 py-0.5 rounded font-bold"><i class="fa-solid fa-clock"></i> H-${diffDays}</span>`;
            return `<span class="bg-emerald-100 text-emerald-800 border border-emerald-200 text-[10px] px-2 py-0.5 rounded font-bold">H-${diffDays}</span>`;
        }

