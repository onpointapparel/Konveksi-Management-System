        /* =========================================================
         * PAYROLL / GAJI KARYAWAN - OWNER ONLY
         * Schema Supabase:
         * employees(employee_id,name,division,rate_per_piece,active,created_at,updated_at)
         * payroll_periods(period_id,period_name,start_date,end_date,status,created_at,closed_at)
         * payroll_items(payroll_item_id,period_id,employee_id,employee_name,division,qty,rate,
         *   gross_amount,paid_amount,remaining_amount,status,notes,created_at,updated_at)
         * payroll_payments(payment_id,payroll_item_id,payment_date,payer_name,amount,method,note,created_by,created_at)
         * =======================================================*/
        let payrollLoaded = false;

        async function loadPayrollData() {
            if (String(appData.role || '').toLowerCase() !== 'owner') return;
            const results = await Promise.all([
                supabaseClient.from('employees').select('*').order('name'),
                supabaseClient.from('payroll_periods').select('*').order('start_date', { ascending: false }),
                supabaseClient.from('payroll_items').select('*').order('created_at', { ascending: false }),
                supabaseClient.from('payroll_payments').select('*').order('payment_date', { ascending: false })
            ]);
            for (const r of results) {
                if (r.error) throw sbError(r.error, 'Gagal memuat data payroll.');
            }

            appData.employees = (results[0].data || []).map(x => ({
                id: x.employee_id,
                name: x.name || '',
                type: x.division || 'Jahit',
                rate: Number(x.rate_per_piece || 0),
                active: x.active !== false,
                note: ''
            }));
            appData.payrollPeriods = results[1].data || [];
            appData.payrollItems = results[2].data || [];
            appData.payrollPayments = results[3].data || [];

            const open = appData.payrollPeriods.find(p => String(p.status).toUpperCase() === 'OPEN');
            if (!appData.activePayrollPeriodId || !appData.payrollPeriods.some(p => String(p.period_id) === String(appData.activePayrollPeriodId))) {
                appData.activePayrollPeriodId = open?.period_id || appData.payrollPeriods[0]?.period_id || '';
            }
            payrollLoaded = true;
            renderPayroll();
        }

        function getActivePayrollPeriod() {
            return appData.payrollPeriods.find(p => String(p.period_id) === String(appData.activePayrollPeriodId)) || null;
        }
        function getPayrollItemsFor(periodId) {
            return appData.payrollItems.filter(x => String(x.period_id) === String(periodId));
        }
        function getPayrollPaidFor(periodId, employeeId) {
            const itemIds = getPayrollItemsFor(periodId)
                .filter(x => String(x.employee_id) === String(employeeId))
                .map(x => String(x.payroll_item_id));
            return appData.payrollPayments
                .filter(x => itemIds.includes(String(x.payroll_item_id)))
                .reduce((s, x) => s + Number(x.amount || 0), 0);
        }
        function getPayrollEmployeeItem(periodId, employeeId) {
            return getPayrollItemsFor(periodId).find(x => String(x.employee_id) === String(employeeId)) || null;
        }
        function getPayrollEmployeeTotal(periodId, employeeId) {
            const item = getPayrollEmployeeItem(periodId, employeeId);
            return Number(item?.gross_amount || 0);
        }
        function payrollStatus(total, paid) {
            if (total <= 0) return 'BELUM ADA';
            if (paid <= 0) return 'BELUM DIBAYAR';
            if (paid < total) return 'SEBAGIAN';
            return 'LUNAS';
        }

        function renderPayroll() {
            const periodSelect = document.getElementById('payroll-period-select');
            const body = document.getElementById('payroll-summary-body');
            const empBody = document.getElementById('employee-table-body');
            if (!periodSelect || !body || !empBody) return;

            periodSelect.innerHTML = appData.payrollPeriods.length
                ? appData.payrollPeriods.map(p => {
                    const open = String(p.status).toUpperCase() === 'OPEN';
                    return `<option value="${p.period_id}" ${String(p.period_id) === String(appData.activePayrollPeriodId) ? 'selected' : ''}>${p.period_name} • ${open ? 'TERBUKA' : 'DITUTUP'}</option>`;
                }).join('')
                : '<option value="">Belum ada periode</option>';

            const period = getActivePayrollPeriod();
            const periodOpen = period && String(period.status).toUpperCase() === 'OPEN';
            document.getElementById('payroll-active-period').innerText = period
                ? `${period.period_name} (${periodOpen ? 'Terbuka' : 'Ditutup'})`
                : 'Belum ada';

            const items = period ? getPayrollItemsFor(period.period_id) : [];
            const total = items.reduce((s, x) => s + Number(x.gross_amount || 0), 0);
            const paid = period ? items.reduce((s, x) => s + getPayrollPaidFor(period.period_id, x.employee_id), 0) : 0;
            document.getElementById('payroll-total-period').innerText = formatRp(total);
            document.getElementById('payroll-unpaid-period').innerText = formatRp(Math.max(0, total - paid));

            const closeBtn = document.getElementById('payroll-close-period-btn');
            if (closeBtn) {
                closeBtn.disabled = !periodOpen;
                closeBtn.classList.toggle('opacity-50', closeBtn.disabled);
            }

            const employees = appData.employees.filter(e => e.active !== false);
            body.innerHTML = employees.length && period
                ? employees.map(e => {
                    const item = getPayrollEmployeeItem(period.period_id, e.id);
                    const qty = Number(item?.qty || 0);
                    const t = Number(item?.gross_amount || 0);
                    const p = getPayrollPaidFor(period.period_id, e.id);
                    const r = Math.max(0, t - p);
                    const st = payrollStatus(t, p);
                    const action = r > 0 && periodOpen
                        ? `<button onclick="openPayrollPaymentModal('${e.id}')" class="px-2 py-1.5 bg-emerald-100 text-emerald-700 rounded-lg font-bold">Bayar</button>`
                        : '';
                    return `<tr>
                        <td class="p-3 font-bold">${e.name}</td>
                        <td class="p-3">${e.type}</td>
                        <td class="p-3">${qty} pcs</td>
                        <td class="p-3">${formatRp(Number(item?.rate || e.rate || 0))}</td>
                        <td class="p-3 font-black">${formatRp(t)}</td>
                        <td class="p-3 font-bold text-emerald-600">${formatRp(p)}</td>
                        <td class="p-3"><span class="px-2 py-1 rounded-full text-[9px] font-black ${st==='LUNAS'?'bg-emerald-100 text-emerald-700':st==='SEBAGIAN'?'bg-amber-100 text-amber-700':'bg-rose-100 text-rose-700'}">${st}</span></td>
                        <td class="p-3 text-center">${action}</td>
                    </tr>`;
                }).join('')
                : `<tr><td colspan="8" class="p-6 text-center text-slate-400">${period ? 'Belum ada karyawan aktif.' : 'Buat periode gaji terlebih dahulu.'}</td></tr>`;

            empBody.innerHTML = employees.length
                ? employees.map(e => `<tr><td class="p-3 font-bold">${e.name}</td><td class="p-3">${e.type}</td><td class="p-3 font-bold">${formatRp(e.rate)}</td><td class="p-3">${e.active !== false ? 'Aktif' : 'Nonaktif'}</td><td class="p-3 text-center"><button onclick="editEmployeeRate('${e.id}')" class="text-brand-600 font-bold">Ubah Tarif</button></td></tr>`).join('')
                : `<tr><td colspan="5" class="p-6 text-center text-slate-400">Belum ada karyawan.</td></tr>`;
        }

