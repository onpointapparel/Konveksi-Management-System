            const currentKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
            const qtyOf = (o) => {
                const fallback = (Array.isArray(o.sizes) ? o.sizes : [])
                    .reduce((n, x) => n + Number(x.qty || 0), 0);
                return Number(o.totalQty || fallback || 0);
            };

            const totalProduction = productionOrders.reduce((sum, o) => sum + qtyOf(o), 0);
            const monthProduction = productionOrders
                .filter(o => monthKey(o.createdAt || o.created_at) === currentKey)
                .reduce((sum, o) => sum + qtyOf(o), 0);

            const defects = appData.defects || [];
            const totalDefect = defects.reduce((sum, d) => sum + Number(d.qty || 0), 0);
            const monthDefect = defects
                .filter(d => monthKey(d.date || d.created_at) === currentKey)
                .reduce((sum, d) => sum + Number(d.qty || 0), 0);

            if (totalEl) totalEl.innerText = `${totalProduction.toLocaleString('id-ID')} Pcs`;
            if (monthEl) monthEl.innerText = `${monthProduction.toLocaleString('id-ID')} Pcs`;
            if (defectEl) defectEl.innerText = `${totalDefect.toLocaleString('id-ID')} Pcs`;
            if (defectMonthEl) defectMonthEl.innerText = `${monthDefect.toLocaleString('id-ID')} Pcs`;

            const grouped = {};
            productionOrders.forEach(o => {
                const key = monthKey(o.createdAt || o.created_at);
                if (!key) return;
                if (!grouped[key]) grouped[key] = { production: 0, defect: 0 };
                grouped[key].production += qtyOf(o);
            });
            defects.forEach(d => {
                const key = monthKey(d.date || d.created_at);
                if (!key) return;
                if (!grouped[key]) grouped[key] = { production: 0, defect: 0 };
                grouped[key].defect += Number(d.qty || 0);
            });

            const keys = Object.keys(grouped).sort().reverse();
            if (!keys.length) {
                body.innerHTML = `<tr><td colspan="4" class="p-8 text-center text-slate-400">Belum ada data produksi atau defect.</td></tr>`;
                return;
            }

            body.innerHTML = keys.map(key => {
                const row = grouped[key];
                const production = Number(row.production || 0);
                const defect = Number(row.defect || 0);
                const defectRate = production > 0 ? ((defect / production) * 100).toFixed(1) : '0.0';
                return `
                    <tr class="hover:bg-slate-50 border-b border-slate-50">
                        <td class="p-3 font-bold text-slate-800">${monthLabel(key)}</td>
                        <td class="p-3 font-black text-brand-700">${production.toLocaleString('id-ID')} Pcs</td>
                        <td class="p-3 font-bold text-rose-600">${defect.toLocaleString('id-ID')} Pcs</td>
                        <td class="p-3 font-semibold text-slate-600">${defectRate}%</td>
                    </tr>
                `;
            }).join('');
        }

