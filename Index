                    {label:'Menunggu', icon:'fa-hourglass-half', color:'amber', statuses:['Antrian','Desain Pending']},
                    {label:'Selesai', icon:'fa-circle-check', color:'green', statuses:['Selesai / Lunas']}
                ];
                const total = Math.max(1, orders.length);
                productionBreakdown.innerHTML = groups.map(group => {
                    const count = orders.filter(order => group.statuses.includes(order.status)).length;
