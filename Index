        function financeDate(value) { return String(value || '').slice(0, 10); }
        function financePeriodById(id) { return (appData.financePeriods || []).find(p => String(p.id) === String(id)); }
        function financePeriodContains(date, period) {
            const d = financeDate(date);
            return !!d && d >= period.startDate && (!period.endDate || d <= period.endDate);
        }
        function orderPaymentRows(order) {
            const tx = Array.isArray(order?.payments) ? order.payments : [];
            if (!tx.length) return [{ amount: Number(order?.dp || 0), date: order?.createdAt || '' }];
            const hasInitialDp = tx.some(p => String(p?.paymentType || p?.payment_type || '').toLowerCase().includes('dp'));
            const rows = tx.map(p => ({ amount: Number(p?.amount || 0), date: p?.date || p?.paymentDate || p?.payment_date || order?.createdAt || '' }));
            if (!hasInitialDp && Number(order?.dp || 0) > 0) rows.push({ amount: Number(order.dp), date: order?.createdAt || '' });
            return rows;
        }
        function financePeriodValues(period) {
            const allHistory = !period;
            const ordersForRevenue = appData.orders.filter(o => allHistory || financePeriodContains(o.createdAt || o.date, period));
            const totalOmset = ordersForRevenue.reduce((sum, o) => sum + Number(o.totalPrice || 0), 0);
            const totalHpp = ordersForRevenue.reduce((sum, o) => sum + Number(o.totalHpp || 0), 0);
            const cashIn = appData.orders.reduce((sum, o) => sum + orderPaymentRows(o).filter(p => allHistory || financePeriodContains(p.date, period)).reduce((s, p) => s + (Number.isFinite(p.amount) ? p.amount : 0), 0), 0);
            const expenses = appData.expenses.filter(e => e.status === 'Approved' && (allHistory || financePeriodContains(e.date, period)));
            const totalExp = expenses.reduce((sum, e) => sum + Number(e.amount || 0), 0);
            const receivableCutoff = period?.endDate || new Date().toISOString().slice(0, 10);
            const receivables = appData.orders.filter(o => financeDate(o.createdAt || o.date) && financeDate(o.createdAt || o.date) <= receivableCutoff).reduce((sum, o) => {
                const paidThroughCutoff = orderPaymentRows(o).filter(p => financeDate(p.date) && financeDate(p.date) <= receivableCutoff).reduce((s, p) => s + (Number.isFinite(p.amount) ? p.amount : 0), 0);
                return sum + Math.max(0, Number(o.totalPrice || 0) - paidThroughCutoff);
            }, 0);
            const netProfit = (totalOmset - totalHpp) - totalExp;
            const recordedBalance = (allHistory ? 0 : Number(period.openingBalance || 0)) + cashIn - totalExp;
            return { totalOmset, cashIn, totalHpp, totalExp, receivables, netProfit, recordedBalance, allHistory };
        }
